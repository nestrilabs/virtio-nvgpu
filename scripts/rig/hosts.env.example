# Copy to hosts-<target>.env (not in git) and fill in. rig.sh reads the one
# RIG_TARGET names.

BUILD_HOST=user@build-host        # builds Rust, has the musl target
BUILD_DIR=nvgpu-rig               # under the build user's home

GPU_HOST=root@gpu-host            # runs guests
GPU_DIR=/root/nvgpu-rig           # where the tree is synced
GPU_BIN=/usr/local/bin            # backend lands here as vhost-user-nvgpu-$TAG
GPU_ROOT=1                        # 1: root on the box. 0: login user, no sudo
GPU_USER=nvgpu-test               # with GPU_ROOT=1, the backend's user

MODULE_ON=gpu                     # gpu: build on GPU_HOST. build: on BUILD_HOST
GPU_KDIR=/root/kernel             # tree for the guest kernel, MODULE_ON=gpu
BUILD_KDIR=                       # tree for the guest kernel, MODULE_ON=build

GPU_KERNEL=/root/kernel/vmlinux   # what the guest boots; must match the tree
GPU_ROOTFS_BASE=/root/guest/rootfs.ext4
GPU_ROOTFS=/root/guest/rootfs-rig.ext4
GPU_VMM=/root/nesbox/target/release/nesbox --config
GPU_SHARE=/var/lib/nvgpu          # host userspace for the guest
GPU_LOGS=/root/logs
