#version 460
// SPDX-License-Identifier: Apache-2.0
// nvgpu-rtprobe: a ray a pixel from a pinhole camera into the TLAS, the hit
// distance written out (rig/heavy/rtprobe.c).
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1) buffer Out { float t[]; } o;
void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  vec2 uv = (vec2(p) + 0.5) / vec2(1920.0, 1080.0) * 2.0 - 1.0;
  vec3 dir = normalize(vec3(uv.x * 1.78, uv.y, 1.0));
  rayQueryEXT q;
  rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xff, vec3(0.0), 0.0, dir, 10000.0);
  while (rayQueryProceedEXT(q)) {
  }
  float d = -1.0;
  if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    d = rayQueryGetIntersectionTEXT(q, true);
  o.t[p.y * 1920u + p.x] = d;
}
