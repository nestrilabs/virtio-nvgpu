config VIRTIO_GPU_NV
	tristate "Virtio NVIDIA GPU proxy driver"
	depends on VIRTIO && DRM && PCI
	select SYNC_FILE
	help
	  Provides /dev/nvidia* device files inside the VM that forward ioctls
	  to the host's NVIDIA driver via a virtio control queue, and a DRM
	  render (and card) node per host GPU. Memory mappings are exposed via
	  KVM memory slots so GPU command submission runs at native speed
	  without any VMM involvement.

	  Required for CUDA, Vulkan, NVENC and NVDEC inside a VM whose VMM
	  offers the virtio-gpu-nv device. If unsure, say N.

config VIRTIO_GPU_NV_RUST
	bool "Parse guest-process input in Rust"
	depends on VIRTIO_GPU_NV && RUST
	help
	  Build the code that reads what a guest process hands the driver --
	  the IOCTL2 schema walk, RM escapes and their nested blocks, deep
	  segments, OS-descriptor registrations, ATOMIC commits -- from its
	  Rust implementation (driver/rust/core: no unsafe, no panic path)
	  instead of the C one. The module says which it has in modinfo
	  ("parsers"). See driver/rust/README.md.

	  If unsure, say N.
