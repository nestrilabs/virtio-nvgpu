+void CDRMLeaseProtocol::readvertise(PHLMONITOR monitor) {
+    // "Upon destruction, the compositor should advertise the connector for leasing again": clients that destroyed their connector object
+    // while leasing get a fresh one; the others already hold a live one and get nothing
+    if (std::ranges::find(m_offeredOutputs, monitor) == m_offeredOutputs.end())
+        return;
+
+    for (auto const& m : m_managers) {
+        if (m->sendConnector(monitor))
+            m->m_resource->sendDone();
+    }
+}
+
+void CDRMLeaseProtocol::withdraw(PHLMONITOR monitor) {
+    const auto IT = std::ranges::find(m_offeredOutputs, monitor);
+    if (IT == m_offeredOutputs.end())
+        return;
+
+    m_offeredOutputs.erase(IT);
+
+    LOGM(Log::DEBUG, "Withdrawing lease offer for {}", monitor->m_name);
+
+    // existing leases on it stay as they are, per protocol
+    for (auto const& m : m_managers) {
+        bool sent = false;
+
+        for (auto const& c : m->m_connectorsSent) {
+            if (!c || c->m_dead || c->m_monitor != monitor)
+                continue;
+
+            c->withdraw();
+            sent = true;
+        }
+
+        if (sent)
+            m->sendDone();
+    }
+}
