+void CDRMLeaseResource::onLeaseGone() {
+    if (m_finished)
+        return;
+
+    m_finished = true;
+
+    LOGM(Log::DEBUG, "Lease {} ended", m_lease ? m_lease->lesseeID : 0);
+
+    // aquamarine emits destroy only after the kernel revoked the lease or destroyed the lessee, so the objects are ours again
+    for (auto const& m : m_monitors) {
+        const auto MON = m.lock();
+        if (!MON)
+            continue;
+
+        MON->onLeaseEnded();
+
+        // deferred: when the lessee's client is disconnecting, its device objects are being torn down right now
+        if (m_protocol && g_pEventLoopManager) {
+            g_pEventLoopManager->doLater([protocol = m_protocol, monitor = m] {
+                const auto PROTOCOL = protocol.lock();
+                const auto MONITOR  = monitor.lock();
+                if (PROTOCOL && MONITOR)
+                    PROTOCOL->readvertise(MONITOR);
+            });
+        }
+    }
+
+    if (!m_destroying)
+        m_resource->sendFinished();
+}
