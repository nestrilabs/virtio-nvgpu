+bool CMonitorRuleParser::parseLeasable(const std::string& value) {
+    // hyprlang's `monitor = ` and `monitorv2 { leasable = }`; the Lua config sets m_leasable from a boolean
+    if (value == "1" || value == "true" || value == "yes" || value == "on") {
+        m_rule.m_leasable = true;
+        return true;
+    }
+
+    if (value == "0" || value == "false" || value == "no" || value == "off") {
+        m_rule.m_leasable = false;
+        return true;
+    }
+
+    m_error += "invalid leasable ";
+    return false;
+}
+
 void CMonitorRuleParser::setDisabled() {
     m_rule.m_disabled = true;
 }
