diff --git a/hyprtester/src/tests/main/monitor_rules.cpp b/hyprtester/src/tests/main/monitor_rules.cpp
index c1dfb92d..760dfc60 100644
--- a/hyprtester/src/tests/main/monitor_rules.cpp
+++ b/hyprtester/src/tests/main/monitor_rules.cpp
@@ -121,3 +121,60 @@ TEST_CASE(monitorMirrorAppliedWhenTargetAppears) {
     ASSERT(waitForMirror(TEST_MIRROR_SOURCE, *RECREATED_TARGET_ID), true);
     EXPECT(monitorBlock(TEST_MIRROR_SOURCE, false).empty(), true);
 }
+
+static bool waitForMonitorBlockContains(const std::string& name, const std::string& needle) {
+    for (int i = 0; i < 50; ++i) {
+        if (monitorBlock(name).contains(needle))
+            return true;
+
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+
+    return false;
+}
+
+TEST_CASE(monitorLeasableRuleIsAppliedWithoutReconnecting) {
+    // Headless outputs can't be DRM-leased, so this covers the plumbing only: the key parses, a change takes the soft rule path (the
+    // monitor stays enabled and in place) and hyprctl reports it. Nothing is leased, so leased stays false throughout.
+    CScopeGuard guard = {[]() { getFromSocket("/reload"); }};
+
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leasable: false");
+
+    OK(getFromSocket("/eval hl.monitor({ output = 'HEADLESS-2', leasable = true })"));
+    ASSERT(waitForMonitorBlockContains("HEADLESS-2", "leasable: true"), true);
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leased: false");
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "disabled: false");
+
+    OK(getFromSocket("/eval hl.monitor({ output = 'HEADLESS-2', leasable = false })"));
+    ASSERT(waitForMonitorBlockContains("HEADLESS-2", "leasable: false"), true);
+}
+
+TEST_CASE(monitorLeaseLesseeAndIntervalAreApplied) {
+    // As above, the plumbing only: the keys parse, take the soft path and are reported. Which clients get the connector, and the
+    // interval's refusal, are in the unit tests (leaseAllowedFor, leaseTooSoon); a real lease needs a DRM device.
+    CScopeGuard guard = {[]() { getFromSocket("/reload"); }};
+
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "lessee: any");
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leaseInterval: 0");
+
+    OK(getFromSocket("/eval hl.monitor({ output = 'HEADLESS-2', leasable = true, lessee = '0', lease_interval = 2000 })"));
+    ASSERT(waitForMonitorBlockContains("HEADLESS-2", "lessee: 0"), true);
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leaseInterval: 2000");
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "disabled: false");
+
+    // a user that does not exist leases to nobody, not to everybody
+    getFromSocket("/eval hl.monitor({ output = 'HEADLESS-2', lessee = 'no-such-user-hyprtester' })");
+    ASSERT(waitForMonitorBlockContains("HEADLESS-2", "lessee: nobody"), true);
+
+    OK(getFromSocket("/eval hl.monitor({ output = 'HEADLESS-2', lessee = '', lease_interval = 0 })"));
+    ASSERT(waitForMonitorBlockContains("HEADLESS-2", "lessee: any"), true);
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leaseInterval: 0");
+}
+
+TEST_CASE(revokeLeaseWithoutALeaseReportsIt) {
+    // nothing is leased on a headless output: the dispatcher says so and changes nothing
+    EXPECT_CONTAINS(getFromSocket("/dispatch hl.dsp.revoke_lease({ monitor = 'HEADLESS-2' })"), "not leased");
+    EXPECT_CONTAINS(getFromSocket("/dispatch hl.dsp.revoke_lease()"), "No active DRM lease");
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "leased: false");
+    EXPECT_CONTAINS(monitorBlock("HEADLESS-2"), "disabled: false");
+}
