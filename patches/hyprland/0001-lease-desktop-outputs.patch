-    if (!SAME_CM || !SAME_POS || !SAME_TRANSFORM || !SAME_AUTO_DIR || !SAME_RESERVED || !SAME_MIRROR)
+    if (!SAME_CM || !SAME_POS || !SAME_TRANSFORM || !SAME_AUTO_DIR || !SAME_RESERVED || !SAME_MIRROR || !SAME_LEASABLE)
         return COMPARISON_SOFT_MISMATCH;
 
     return COMPARISON_FULL_MATCH;
 }
+
+bool Config::leaseAllowedFor(const std::optional<uid_t>& lessee, uid_t clientUid) {
+    if (!lessee)
+        return true;
+
+    // LEASE_NOBODY is also the uid libwayland reports when it could not read the peer's credentials
+    return *lessee != LEASE_NOBODY && *lessee == clientUid;
+}
+
+bool Config::leaseTooSoon(uint32_t intervalMs, const std::optional<std::chrono::steady_clock::time_point>& last, std::chrono::steady_clock::time_point now) {
+    if (intervalMs == 0 || !last)
+        return false;
+
+    // a clock that went backwards (it cannot, it is steady) would read as too soon rather than wrap
+    if (now < *last)
+        return true;
+
+    return now - *last < std::chrono::milliseconds(intervalMs);
+}
