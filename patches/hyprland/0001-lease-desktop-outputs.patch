@@ -239,6 +239,15 @@ static int dsp_releaseInputCapture(lua_State* L) {
     return Internal::checkResult(L, CA::releaseInputCapture());
 }
 
+static int dsp_revokeLease(lua_State* L) {
+    if (lua_isnil(L, lua_upvalueindex(1)))
+        return Internal::checkResult(L, CA::revokeLease());
+
+    // looked up when it runs, not when the bind is made: a monitor can come and go in between
+    PHLMONITOR mon = State::monitorState()->query().relativeTo(Desktop::focusState()->monitor()).configString(lua_tostring(L, lua_upvalueindex(1))).run();
+    return Internal::checkResult(L, CA::revokeLease(mon));
+}
+
 static int hlExecCmd(lua_State* L) {
     const auto proc = Check::string(L, 1);
 
@@ -364,6 +373,20 @@ static int hlReleaseInputCapture(lua_State* L) {
     return 1;
 }
 
+// hl.dsp.revoke_lease() or hl.dsp.revoke_lease({ monitor = "DP-2" })
+static int hlRevokeLease(lua_State* L) {
+    std::optional<std::string> monStr;
+    if (lua_istable(L, 1))
+        monStr = Internal::tableOptMonitorSelector(L, 1, "monitor", "hl.dsp.revoke_lease");
+
+    if (monStr)
+        lua_pushstring(L, monStr->c_str());
+    else
+        lua_pushnil(L);
+    lua_pushcclosure(L, dsp_revokeLease, 1);
+    return 1;
+}
