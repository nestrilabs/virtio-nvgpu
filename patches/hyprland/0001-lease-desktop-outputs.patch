+void CMonitor::setLeaseOffered(const Config::CMonitorRule& rule) {
+    // HMDs keep the upstream behaviour: onConnect offers them and only their destruction withdraws them
+    if (!m_output || m_output->nonDesktop)
+        return;
+
+    const bool offered = rule.m_leasable;
+
+    // offer() also re-checks which bindings of the lease device may see the output, so a lessee change takes effect now
+    m_leaseLessee   = rule.m_lessee;
+    m_leaseInterval = rule.m_leaseInterval;
+
+    bool found = false;
+    for (auto const& [name, lease] : PROTO::lease) {
+        if (!lease || m_output->getBackend() != lease->getBackend())
+            continue;
+
+        found = true;
+
+        if (offered)
+            lease->offer(m_self.lock());
+        else
+            lease->withdraw(m_self.lock());
+    }
+
+    if (offered && !found)
+        LOG(Log::WARN, "Monitor {} is leasable, but its backend has no DRM lease device", m_name);
+}
+
+bool CMonitor::releaseForLease() {
+    if (!m_output || m_isBeingLeased)
+        return false;
+
+    // Leasing a monitor we drive is a disconnect as far as the desktop is concerned: onDisconnect moves the workspaces and focus away,
+    // drops the frame scheduler and any queued async commit, and commits the output disabled. That commit goes through
+    // CDRMOutput::commit(), which cancels aquamarine's pending async commit and pauses the CRTC's commit queue first, and it is a
+    // blocking modeset, so by the time it returns the kernel has finished our last flip and the CRTC is off with no plane holding one of
+    // our framebuffers. The caller checks it actually got there. HMDs and monitors disabled by a rule were never driven, so there is
+    // nothing to let go of.
+    if (m_output->nonDesktop) {
+        m_isBeingLeased = true;
+        return true;
+    }
+
+    if (m_enabled) {
+        LOG(Log::DEBUG, "Releasing monitor {} for a DRM lease", m_name);
+        onDisconnect();
+    }
+
+    // Aquamarine re-commits every output that has a mode when the session comes back from a VT switch (CDRMBackend::restoreAfterVT),
+    // disabled ones included, which would modeset the lessee's CRTC off. Without a mode it asks for a new state instead, which our state
+    // listener ignores while leased. onConnect sets a mode again when the lease ends.
+    m_output->state->setMode(nullptr);
+
+    m_isBeingLeased = true;
+    return true;
+}
+
+void CMonitor::onLeaseEnded() {
+    if (!m_isBeingLeased)
+        return;
+
+    m_isBeingLeased = false;
+
+    if (!m_output || m_output->nonDesktop)
+        return;
+
+    if (!g_pCompositor || g_pCompositor->m_isShuttingDown || !g_pEventLoopManager)
+        return;
+
+    // The lease ends from inside aquamarine's udev handling (lessee closed its fd), from a wayland destructor (client destroyed the
+    // lease) or from a monitor being destroyed, none of which is a good place to modeset. Reconnecting also has to wait for the lease to
+    // be revoked, which it is by the time the destroy event fires. The lessee may have left anything on the CRTC; onConnect applies
+    // the current rule with a full modeset, exactly as if the monitor had just been plugged in.
+    g_pEventLoopManager->doLater([self = m_self] {
+        const auto PMONITOR = self.lock();
+        if (!PMONITOR || !PMONITOR->m_output || PMONITOR->m_isBeingLeased || PMONITOR->m_enabled)
+            return;
+
+        LOG(Log::DEBUG, "Lease on {} ended, reconfiguring it", PMONITOR->m_name);
+
+        // releaseForLease() cleared the mode; an enabling rule sets one again, but a disabling rule's commit needs one too (aquamarine
+        // rejects modeless commits), and that commit is what turns off whatever the lessee left on screen
+        if (const auto& STATE = PMONITOR->m_output->state->state(); !STATE.mode && !STATE.customMode)
+            PMONITOR->m_output->state->setMode(PMONITOR->m_currentMode ? PMONITOR->m_currentMode : PMONITOR->m_output->preferredMode());
+
+        // The lessee may still have a flip queued (a lease revoked from hyprctl ends whenever the user says, not when the lessee is done),
+        // and may have left its framebuffers on the planes it held: the primary, which our modeset replaces, and the cursor, which it does
+        // not (aquamarine only touches the cursor plane when the cursor changes). A commit with no buffer is a blocking modeset: the kernel
+        // lets the lessee's last flip complete, then takes both planes off the CRTC. Only then does onConnect render to it again.
+        PMONITOR->m_output->state->resetExplicitFences();
+        PMONITOR->m_output->state->setEnabled(false);
+        if (!PMONITOR->m_state.commit())
+            LOG(Log::WARN, "Couldn't clear {} after its lease, reconfiguring it anyway", PMONITOR->m_name);
+
+        PMONITOR->onConnect(false);
+    });
+}
