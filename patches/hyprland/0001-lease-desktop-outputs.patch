 }
 
+bool CMonitorRuleParser::parseLessee(const std::string& value) {
+    // empty: any client that can see the lease device, as without the key
+    if (value.empty()) {
+        m_rule.m_lessee.reset();
+        return true;
+    }
+
+    // Anything that does not name a real uid leases to nobody rather than to anyone: a typo must not open the monitor up
+    m_rule.m_lessee = LEASE_NOBODY;
+
+    if (std::ranges::all_of(value, [](char c) { return c >= '0' && c <= '9'; })) {
+        uint64_t uid         = 0;
+        const auto [ptr, ec] = std::from_chars(value.data(), value.data() + value.size(), uid);
+        if (ec != std::errc{} || ptr != value.data() + value.size() || uid >= LEASE_NOBODY) {
+            m_error += "invalid lessee ";
+            return false;
+        }
+
+        m_rule.m_lessee = sc<uid_t>(uid);
+        return true;
+    }
+
+    // a user name, resolved once here rather than at every bind
+    long bufSize = sysconf(_SC_GETPW_R_SIZE_MAX);
+    if (bufSize <= 0)
+        bufSize = 16384;
+
+    std::vector<char> buf(sc<size_t>(bufSize));
+    passwd            pw     = {};
+    passwd*           result = nullptr;
+    if (getpwnam_r(value.c_str(), &pw, buf.data(), buf.size(), &result) != 0 || !result || result->pw_uid == LEASE_NOBODY) {
+        m_error += "invalid lessee (no such user) ";
+        return false;
+    }
+
+    m_rule.m_lessee = result->pw_uid;
+    return true;
+}
+
+bool CMonitorRuleParser::parseLeaseInterval(const std::string& value) {
+    uint64_t ms          = 0;
+    const auto [ptr, ec] = std::from_chars(value.data(), value.data() + value.size(), ms);
+    if (value.empty() || ec != std::errc{} || ptr != value.data() + value.size() || ms > LEASE_INTERVAL_MAX_MS) {
+        m_error += "invalid lease_interval ";
+        return false;
+    }
+
+    m_rule.m_leaseInterval = sc<uint32_t>(ms);
+    return true;
+}
+
 void CMonitorRuleParser::setDisabled() {
     m_rule.m_disabled = true;
 }
