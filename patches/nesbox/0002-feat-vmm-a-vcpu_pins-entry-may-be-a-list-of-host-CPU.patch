diff --git a/vmm/src/config.rs b/vmm/src/config.rs
index 0095499..7efb57a 100644
--- a/vmm/src/config.rs
+++ b/vmm/src/config.rs
@@ -313,15 +313,18 @@ pub struct MachineConfig {
     /// this end only carries it out, the same way `vcpu_count` works.
     #[serde(default)]
