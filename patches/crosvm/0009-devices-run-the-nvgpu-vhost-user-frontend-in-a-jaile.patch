+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! A virtio-nvgpu vhost-user frontend does its work in a process of its own under the seccomp
+//! policy crosvm jails it with (`vhost_user_frontend_device`), keeping only the descriptors it
+//! says it needs.
+//!
+//! Three processes, as in crosvm: this one plays the main process (it makes the frontend, gives it
+//! a real `VmRequester` over a memory tube, and answers that tube); a forked one is the backend,
+//! which serves the frontend and sends it shared memory requests on both regions; and the frontend
+//! runs in a jailed child, where it reads the device config, activates, forwards the backend's
+//! window mappings and UVM pools to the main process, and resets. A syscall the policy lacks kills
+//! the child with SIGSYS; a descriptor missing from `keep_rds` fails it.
+//!
+//! Forking needs a single-threaded process, so this runs without the test harness.
+
+#[cfg(any(target_os = "android", target_os = "linux"))]
+mod test {
+    use std::fs::File;
+    use std::os::fd::AsFd;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+
+    use base::AsRawDescriptor;
+    use base::AsRawDescriptors;
+    use base::Event;
+    use base::RawDescriptor;
+    use base::SafeDescriptor;
+    use base::Tube;
+    use devices::virtio::DeviceType;
+    use devices::virtio::Interrupt;
+    use devices::virtio::QueueConfig;
+    use devices::virtio::SharedMemoryPrepareType;
+    use devices::virtio::VhostUserFrontend;
+    use devices::virtio::VirtioDevice;
+    use devices::virtio::VmRequester;
+    use hypervisor::MemCacheType;
+    use resources::Alloc;
+    use vm_control::api::VmMemoryClient;
+    use vm_control::VmMemoryRegionId;
+    use vm_control::VmMemoryRequest;
+    use vm_control::VmMemoryResponse;
+    use vm_memory::GuestAddress;
+    use vm_memory::GuestMemory;
+    use vmm_vhost::message::*;
+    use vmm_vhost::Backend;
+    use vmm_vhost::BackendServer;
+    use vmm_vhost::Connection;
+    use vmm_vhost::Frontend;
+    use vmm_vhost::FrontendClient;
+    use vmm_vhost::SharedMemoryRegion;
+    use vmm_vhost::VHOST_USER_F_PROTOCOL_FEATURES;
+
+    const MIB: u64 = 1 << 20;
+    const ALLOC: Alloc = Alloc::PciBar {
+        bus: 0,
+        dev: 5,
+        func: 0,
+        bar: 2,
+    };
+
+    /// The backend: every request answered, and the channel for its own requests kept.
+    struct FakeBackend {
+        req: Arc<Mutex<Option<FrontendClient>>>,
+    }
+
+    type R<T> = vmm_vhost::Result<T>;
+
+    impl Backend for FakeBackend {
+        fn set_owner(&mut self) -> R<()> {
+            Ok(())
+        }
+        fn reset_owner(&mut self) -> R<()> {
+            Ok(())
+        }
+        fn get_features(&mut self) -> R<u64> {
+            Ok(1 << VHOST_USER_F_PROTOCOL_FEATURES
+                | 1 << virtio_sys::virtio_config::VIRTIO_F_VERSION_1)
+        }
+        fn set_features(&mut self, _: u64) -> R<()> {
+            Ok(())
+        }
+        fn set_mem_table(&mut self, _: &[VhostUserMemoryRegion], _: Vec<File>) -> R<()> {
+            Ok(())
+        }
+        fn set_vring_num(&mut self, _: u32, _: u32) -> R<()> {
+            Ok(())
+        }
+        fn set_vring_addr(
+            &mut self,
+            _: u32,
+            _: VhostUserVringAddrFlags,
+            _: u64,
+            _: u64,
+            _: u64,
+            _: u64,
+        ) -> R<()> {
+            Ok(())
+        }
+        fn set_vring_base(&mut self, _: u32, _: u32) -> R<()> {
+            Ok(())
+        }
+        fn get_vring_base(&mut self, index: u32) -> R<VhostUserVringState> {
+            Ok(VhostUserVringState::new(index, 0))
+        }
+        fn set_vring_kick(&mut self, _: u8, _: Option<File>) -> R<()> {
+            Ok(())
+        }
+        fn set_vring_call(&mut self, _: u8, _: Option<File>) -> R<()> {
+            Ok(())
+        }
+        fn set_vring_err(&mut self, _: u8, _: Option<File>) -> R<()> {
+            Ok(())
+        }
+        fn get_protocol_features(&mut self) -> R<VhostUserProtocolFeatures> {
+            Ok(VhostUserProtocolFeatures::CONFIG
+                | VhostUserProtocolFeatures::MQ
+                | VhostUserProtocolFeatures::BACKEND_REQ
+                | VhostUserProtocolFeatures::SHMEM
+                | VhostUserProtocolFeatures::REPLY_ACK)
+        }
+        fn set_protocol_features(&mut self, _: u64) -> R<()> {
+            Ok(())
+        }
+        fn get_queue_num(&mut self) -> R<u64> {
+            Ok(2)
+        }
+        fn set_vring_enable(&mut self, _: u32, _: bool) -> R<()> {
+            Ok(())
+        }
+        fn get_config(&mut self, _: u32, size: u32, _: VhostUserConfigFlags) -> R<Vec<u8>> {
+            Ok(vec![0x5a; size as usize])
+        }
+        fn set_config(&mut self, _: u32, _: &[u8], _: VhostUserConfigFlags) -> R<()> {
+            Ok(())
+        }
+        fn set_backend_req_fd(&mut self, conn: Connection) {
+            *self.req.lock().unwrap() = Some(FrontendClient::new(conn, true));
+        }
+        fn get_inflight_fd(&mut self, _: &VhostUserInflight) -> R<(VhostUserInflight, File)> {
+            Err(vmm_vhost::Error::InvalidOperation)
+        }
+        fn set_inflight_fd(&mut self, _: &VhostUserInflight, _: File) -> R<()> {
+            Err(vmm_vhost::Error::InvalidOperation)
+        }
+        fn get_max_mem_slots(&mut self) -> R<u64> {
+            Ok(0)
+        }
+        fn add_mem_region(&mut self, _: &VhostUserSingleMemoryRegion, _: File) -> R<()> {
+            Ok(())
+        }
+        fn remove_mem_region(&mut self, _: &VhostUserSingleMemoryRegion) -> R<()> {
+            Ok(())
+        }
+        fn set_device_state_fd(
+            &mut self,
+            _: VhostUserTransferDirection,
+            _: VhostUserMigrationPhase,
+            _: File,
+        ) -> R<Option<File>> {
+            Err(vmm_vhost::Error::InvalidOperation)
+        }
+        fn check_device_state(&mut self) -> R<()> {
+            Err(vmm_vhost::Error::InvalidOperation)
+        }
+        fn get_shmem_config(&mut self) -> R<Vec<SharedMemoryRegion>> {
+            Ok(vec![
+                SharedMemoryRegion {
+                    id: 1,
+                    length: 1 << 30,
+                },
+                SharedMemoryRegion {
+                    id: 2,
+                    length: 1 << 30,
+                },
+            ])
+        }
+    }
+
+    fn memfd(len: u64) -> SafeDescriptor {
+        let shm = base::SharedMemory::new("test", len).unwrap();
+        SafeDescriptor::from(shm)
+    }
+
+    fn mmap_msg(shmid: u8, shm_offset: u64, len: u64, fd_offset: u64) -> VhostUserMMap {
+        VhostUserMMap {
+            shmid,
+            fd_offset,
+            shm_offset,
+            len,
+            flags: VhostUserMMapFlags::MAP_RW,
+            ..Default::default()
+        }
+    }
+
+    /// What the backend does once told to: map in the window, place a pool, take the first window
+    /// mapping away again, and map another, which the frontend's reset takes away later.
+    fn backend_requests(client: &mut FrontendClient) -> Result<(), String> {
+        let hva = 8u64 << 30;
+        client
+            .shmem_map(&mmap_msg(1, 0, 2 * MIB, 0), &memfd(2 * MIB))
+            .map_err(|e| format!("window map: {e}"))?;
+        client
+            .shmem_map(&mmap_msg(2, 0, 2 * MIB, hva), &memfd(4096))
+            .map_err(|e| format!("pool map: {e}"))?;
+        client
+            .shmem_unmap(&mmap_msg(1, 0, 2 * MIB, 0))
+            .map_err(|e| format!("window unmap: {e}"))?;
+        client
+            .shmem_map(&mmap_msg(1, 4 * MIB, MIB, 0), &memfd(MIB))
+            .map_err(|e| format!("second window map: {e}"))?;
+        // Refused by the frontend itself, before the main process hears of it: outside the band.
+        if client
+            .shmem_map(&mmap_msg(2, 2 * MIB, 2 * MIB, 4096), &memfd(4096))
+            .is_ok()
+        {
+            return Err("a pool outside the band was accepted".into());
+        }
+        Ok(())
+    }
+
+    /// The backend process: serves the frontend on one thread, and on command sends its requests.
+    fn run_backend(conn: Connection, ctl: Tube) {
+        let req = Arc::new(Mutex::new(None));
+        let mut server = BackendServer::new(conn, FakeBackend { req: req.clone() });
+        std::thread::spawn(move || {
+            while let Ok((hdr, files)) = server.recv_header() {
+                if server.process_message(hdr, files).is_err() {
+                    break;
+                }
+            }
+        });
+        loop {
+            match ctl.recv::<String>().unwrap().as_str() {
+                "go" => {
+                    let mut guard = req.lock().unwrap();
+                    let client = guard.as_mut().expect("no backend request channel");
+                    ctl.send(&backend_requests(client).err().unwrap_or_default())
+                        .unwrap();
+                }
+                _ => return,
+            }
+        }
+    }
+
+    /// What reached the main process, in order.
+    fn describe(r: &VmMemoryRequest) -> String {
+        match r {
+            VmMemoryRequest::PrepareSharedMemoryRegion { .. } => "prepare".into(),
+            VmMemoryRequest::RegisterMemory { dest, .. } => match dest {
+                vm_control::VmMemoryDestination::ExistingAllocation { offset, .. } => {
+                    format!("map {offset:#x}")
+                }
+                _ => "map elsewhere".into(),
+            },
+            VmMemoryRequest::UnregisterMemory(VmMemoryRegionId(a)) => format!("unmap {:#x}", a.0),
+            VmMemoryRequest::RegisterUvmPool {
+                host_address,
+                size,
+                offset,
+                ..
+            } => format!("pool {host_address:#x}+{size:#x} at {offset:#x}"),
+            VmMemoryRequest::UnregisterUvmPool { offset, size, .. } => {
+                format!("unpool {offset:#x}+{size:#x}")
+            }
+            _ => "other".into(),
+        }
+    }
+
+    /// The main process's side of the memory tube: everything succeeds, and is written down.
+    fn serve_memory_tube(tube: Tube, log: Arc<Mutex<Vec<String>>>) {
+        while let Ok(r) = tube.recv::<VmMemoryRequest>() {
+            log.lock().unwrap().push(describe(&r));
+            let response = match r {
+                VmMemoryRequest::RegisterMemory { dest, .. } => match dest {
+                    vm_control::VmMemoryDestination::ExistingAllocation { offset, .. } => {
+                        VmMemoryResponse::RegisterMemory {
+                            region_id: VmMemoryRegionId(GuestAddress(offset)),
+                            slot: 7,
+                        }
+                    }
+                    _ => VmMemoryResponse::Ok,
+                },
+                _ => VmMemoryResponse::Ok,
+            };
+            tube.send(&response).unwrap();
+        }
+    }
+
+    fn open_fds() -> Vec<RawDescriptor> {
+        let listed: Vec<RawDescriptor> = std::fs::read_dir("/proc/self/fd")
+            .unwrap()
+            .filter_map(|e| e.ok()?.file_name().to_str()?.parse().ok())
+            .collect();
+        // Not the directory's own descriptor, closed by now.
+        listed
+            .into_iter()
+            // SAFETY: F_GETFD only asks whether the descriptor is open.
+            .filter(|&fd| unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0)
+            .collect()
+    }
+
+    /// Say which syscall the policy refused, rather than only dying of it.
+    extern "C" fn on_sigsys(_: libc::c_int, info: *mut libc::siginfo_t, _: *mut libc::c_void) {
+        // SAFETY: the kernel hands a SIGSYS handler a siginfo whose _sigsys member holds the
+        // syscall number at this offset on 64-bit Linux; write and _exit are async-signal-safe.
+        unsafe {
+            let nr = *((info as *const u8).add(24) as *const libc::c_int);
+            let msg = format!("jailed frontend: syscall {nr} is not in the policy\n");
+            libc::write(2, msg.as_ptr() as *const libc::c_void, msg.len());
+            libc::_exit(3);
+        }
+    }
+
+    pub fn jailed_frontend_runs_under_its_policy() {
+        // The backend, forked while this process has no threads.
+        let (front_conn, back_conn) = Connection::pair().unwrap();
+        let (backend_ctl, backend_ctl_child) = Tube::pair().unwrap();
+        let backend = jail::fork_process(
+            minijail::Minijail::new().unwrap(),
+            vec![
+                back_conn.as_raw_descriptor(),
+                backend_ctl_child.as_raw_descriptor(),
+                2,
+            ],
+            Some("fake-backend".into()),
+            move || run_backend(back_conn, backend_ctl_child),
+        )
+        .unwrap();
+
+        // What the jailed process inherits besides the frontend's own: what the transport and
+        // crosvm hand every device process (guest memory, its interrupt, stderr for logs), made
+        // before the frontend.
+        let mem = GuestMemory::new(&[(GuestAddress(0), 0x10000)]).unwrap();
+        let interrupt = Interrupt::new_for_test_with_msix();
+        let (ctl, ctl_child) = Tube::pair().unwrap();
+        let baseline = open_fds();
+
+        let (main_tube, device_tube) = Tube::pair().unwrap();
+        let (vm_evt_wrtube, _vm_evt_rdtube) = Tube::directional_pair().unwrap();
+        let mut frontend = VhostUserFrontend::new(
+            DeviceType::Nvgpu,
+            1 << virtio_sys::virtio_config::VIRTIO_F_VERSION_1,
+            front_conn,
+            vm_evt_wrtube,
+            None,
+            None,
+            true,
+        )
+        .unwrap();
+        // As the transport does, in the main process before the fork.
+        let window = frontend.get_shared_memory_region().expect("no window");
+        assert_eq!((window.id, window.length), (1, 1 << 30));
+        let extra = frontend.get_extra_shared_memory_regions();
+        assert_eq!(extra.len(), 1);
+        assert_eq!((extra[0].id, extra[0].length), (2, 1 << 30));
+        frontend.set_shared_memory_mapper(Box::new(VmRequester::new(
+            VmMemoryClient::new(device_tube),
+            ALLOC,
+            SharedMemoryPrepareType::SingleMappingOnFirst(MemCacheType::CacheCoherent),
+        )));
+
+        let mut keep = baseline.clone();
+        keep.extend(frontend.keep_rds());
+        keep.extend(mem.as_raw_descriptors());
+        keep.push(ctl_child.as_raw_descriptor());
+
+        let mut jail = minijail::Minijail::new().unwrap();
+        // minijail's own complaints to stderr, not syslog.
+        jail.log_to_fd(
+            std::os::fd::OwnedFd::from(std::io::stderr().as_fd().try_clone_to_owned().unwrap()),
+            libc::LOG_INFO,
+        );
+        jail::set_embedded_bpf_program(&mut jail, "vhost_user_frontend_device").unwrap();
+        jail.no_new_privs();
+        jail.use_seccomp_filter();
+
+        // SAFETY: installs a handler that only writes and exits; nothing else handles SIGSYS.
+        unsafe {
+            let mut sa: libc::sigaction = std::mem::zeroed();
+            sa.sa_sigaction = on_sigsys as usize;
+            sa.sa_flags = libc::SA_SIGINFO;
+            libc::sigaction(libc::SIGSYS, &sa, std::ptr::null_mut());
+        }
+
+        let child = jail::fork_process(jail, keep, Some("vu-nvgpu".into()), move || {
+            let mut config = [0u8; 64];
+            frontend.read_config(0, &mut config);
+            assert_eq!(config, [0x5a; 64]);
+            frontend.ack_features(1 << virtio_sys::virtio_config::VIRTIO_F_VERSION_1);
+            let mut queues = std::collections::BTreeMap::new();
+            for i in 0..2 {
+                let mut q = QueueConfig::new(0x10, 0);
+                q.set_ready(true);
+                queues.insert(
+                    i,
+                    q.activate(&mem, Event::new().unwrap(), interrupt.clone())
+                        .unwrap(),
+                );
+            }
+            frontend.activate(mem, interrupt, queues).unwrap();
+            ctl_child.send(&"activated".to_string()).unwrap();
+            assert_eq!(ctl_child.recv::<String>().unwrap(), "reset");
+            frontend.reset().unwrap();
+            ctl_child.send(&"reset".to_string()).unwrap();
+        })
+        .unwrap();
+
+        // Now this process may have threads: the main process's end of the memory tube.
+        let log = Arc::new(Mutex::new(Vec::new()));
+        let server = std::thread::spawn({
+            let log = log.clone();
+            move || serve_memory_tube(main_tube, log)
+        });
+
+        assert_eq!(ctl.recv::<String>().unwrap(), "activated");
+        backend_ctl.send(&"go".to_string()).unwrap();
+        let err = backend_ctl.recv::<String>().unwrap();
+        assert!(err.is_empty(), "backend: {err}");
+        ctl.send(&"reset".to_string()).unwrap();
+        assert_eq!(ctl.recv::<String>().unwrap(), "reset");
+        let status = child.wait().unwrap();
+        assert_eq!(status, 0, "the jailed frontend exited with {status}");
+        server.join().unwrap();
+
+        let log = log.lock().unwrap().clone();
+        assert_eq!(
+            log,
+            vec![
+                "prepare".to_string(),
+                format!("map {:#x}", 0),
+                // The aperture sits after the 1 GiB window in the BAR.
+                format!("pool {:#x}+{:#x} at {:#x}", 8u64 << 30, 2 * MIB, 1u64 << 30),
+                format!("unmap {:#x}", 0),
+                format!("map {:#x}", 4 * MIB),
+                // The reset: whatever is still mapped, window and pool.
+                format!("unmap {:#x}", 4 * MIB),
+                format!("unpool {:#x}+{:#x}", 1u64 << 30, 2 * MIB),
+            ]
+        );
+
+        backend_ctl.send(&"exit".to_string()).unwrap();
+        assert_eq!(backend.wait().unwrap(), 0);
+        println!("jailed_frontend_runs_under_its_policy: ok");
+    }
+
+    /// The policy is really in force: under it, a socket or a KVM-style ioctl stops the process.
+    pub fn the_policy_refuses_what_the_frontend_never_does() {
+        for (what, call) in [
+            (
+                "socket",
+                (|| {
+                    // SAFETY: a plain syscall; the policy stops it.
+                    unsafe { libc::socket(libc::AF_INET, libc::SOCK_STREAM, 0) };
+                }) as fn(),
+            ),
+            ("ioctl", || {
+                // KVM_CREATE_VM on stderr: an ioctl the policy has no rule for.
+                // SAFETY: a plain syscall; the policy stops it.
+                unsafe { libc::ioctl(2, 0xae01, 0) };
+            }),
+            ("open", || {
+                // Refused with ENOENT, not stopped: the process goes on.
+                assert!(File::open("/proc/self/maps").is_err());
+                // SAFETY: a plain syscall; the policy stops it.
+                unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_STREAM, 0) };
+            }),
+        ] {
+            let mut jail = minijail::Minijail::new().unwrap();
+            jail::set_embedded_bpf_program(&mut jail, "vhost_user_frontend_device").unwrap();
+            jail.no_new_privs();
+            jail.use_seccomp_filter();
+            let child = jail::fork_process(jail, vec![2], None, move || call()).unwrap();
+            // on_sigsys exits 3.
+            assert_eq!(child.wait().unwrap(), 3, "{what} was not stopped");
+        }
+        println!("the_policy_refuses_what_the_frontend_never_does: ok");
+    }
+}
+
+fn main() {
+    #[cfg(any(target_os = "android", target_os = "linux"))]
+    test::jailed_frontend_runs_under_its_policy();
+    test::the_policy_refuses_what_the_frontend_never_does();
+}
