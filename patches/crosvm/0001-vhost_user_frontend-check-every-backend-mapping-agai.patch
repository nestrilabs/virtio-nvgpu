 struct SharedMapperState {
     mapper: Box<dyn SharedMemoryMapper>,
     shmid: u8,
+    /// Length of the region the guest sees, as the backend reported it.
+    length: u64,
+    /// Live mappings, offset -> length. The mapper keys mappings by offset
+    /// alone, and a later mapping silently replaces the host pages under an
+    /// earlier one, so an overlap would leave an unmap tearing down pages it
+    /// never mapped. Overlaps are refused instead.
+    mappings: BTreeMap<u64, u64>,
+}
+
+/// The end of the pages `[offset, offset + len)` touches, or `None` on overflow.
+fn page_end(offset: u64, len: u64) -> Option<u64> {
+    let page = base::pagesize() as u64;
+    offset.checked_add(len)?.checked_next_multiple_of(page)
+}
+
+impl SharedMapperState {
+    fn check_shmid(&self, shmid: u8) -> HandlerResult<()> {
+        if shmid != self.shmid {
+            error!("bad shmid {}, expected {}", shmid, self.shmid);
+            return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        Ok(())
+    }
+
+    /// Whether `[offset, offset + len)` may be mapped: at page-aligned
+    /// offsets, inside the region, and clear of every live mapping. A length
+    /// that is not a whole number of pages maps its last page whole, as mmap
+    /// does, so the pages it covers are what is checked. The backend is
+    /// another process and may be compromised; nothing it asks for is placed
+    /// until this has held.
+    fn check_new_mapping(&self, offset: u64, len: u64, fd_offset: u64) -> HandlerResult<()> {
+        let page = base::pagesize() as u64;
+        let end = match page_end(offset, len) {
+            Some(end)
+                if len != 0
+                    && offset % page == 0
+                    && fd_offset % page == 0
+                    && fd_offset.checked_add(len).is_some()
+                    && end <= self.length =>
+            {
+                end
+            }
+            _ => {
+                error!(
+                    "refusing mapping {:#x}+{:#x} (file offset {:#x}): not page aligned or \
+                     outside the {:#x}-byte region {}",
+                    offset, len, fd_offset, self.length, self.shmid
+                );
+                return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+            }
+        };
+        if let Some((&start, &l)) = self.mappings.range(..end).next_back() {
+            if page_end(start, l).is_some_and(|e| e > offset) {
+                error!(
+                    "refusing mapping {:#x}+{:#x}: overlaps {:#x}+{:#x} in region {}",
+                    offset, len, start, l, self.shmid
+                );
+                return Err(std::io::Error::from_raw_os_error(libc::EEXIST));
+            }
+        }
+        Ok(())
+    }
+
+    fn add(
+        &mut self,
+        source: VmMemorySource,
+        offset: u64,
+        len: u64,
+        prot: Protection,
+    ) -> HandlerResult<()> {
+        self.mapper
+            .add_mapping(source, offset, prot, MemCacheType::CacheCoherent)
+            .map_err(|e| {
+                error!("failed to create mapping {:?}", e);
+                std::io::Error::other(e.context("add mapping"))
+            })?;
+        self.mappings.insert(offset, len);
+        Ok(())
+    }
+
+    /// Removes the mapping at exactly `offset`, which must have been made with
+    /// exactly `len`: the mapper can only take a mapping away whole.
+    fn remove(&mut self, offset: u64, len: u64) -> HandlerResult<()> {
+        if self.mappings.get(&offset) != Some(&len) {
+            error!(
+                "refusing unmap {:#x}+{:#x} in region {}: no such mapping",
+                offset, len, self.shmid
+            );
+            return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        self.mapper.remove_mapping(offset).map_err(|e| {
+            error!("failed to remove mapping {:?}", e);
+            std::io::Error::other(e.context("remove memory mapping based on shm offset"))
+        })?;
+        self.mappings.remove(&offset);
+        Ok(())
+    }
 }
 
 pub struct BackendReqHandlerImpl {
@@ -49,67 +150,62 @@ impl BackendReqHandlerImpl {
     pub(crate) fn set_shared_mapper_state(
         &mut self,
         mapper: Box<dyn SharedMemoryMapper>,
-        shmid: u8,
+        region: SharedMemoryRegion,
     ) {
-        self.shared_mapper_state = Some(SharedMapperState { mapper, shmid });
+        self.shared_mapper_state = Some(SharedMapperState {
+            mapper,
+            shmid: region.id,
+            length: region.length,
+            mappings: BTreeMap::new(),
+        });
+    }
+
+    /// Takes down every mapping the backend made. The vhost-user
+    /// specification has the front-end do this across a device reset.
+    pub(crate) fn unmap_all(&mut self) {
+        let Some(state) = self.shared_mapper_state.as_mut() else {
+            return;
+        };
+        for (offset, len) in std::mem::take(&mut state.mappings) {
+            if let Err(e) = state.mapper.remove_mapping(offset) {
+                warn!(
+                    "reset: failed to remove mapping {:#x}+{:#x}: {:#}",
+                    offset, len, e
+                );
+            }
+        }
     }
 }
 
