+/// virtio-nvgpu's window: the shared memory region its guest driver maps device memory through.
+const NVGPU_SHM_ID_WINDOW: u8 = 1;
+
+/// Ring features a device type's backend may negotiate with the guest beyond the common ones.
+///
+/// Only features that live entirely in the rings belong here: the backend walks the rings and
+/// this process never reads a descriptor.
+fn ring_features(device_type: DeviceType) -> u64 {
+    match device_type {
+        // Indirect descriptors let one ring slot carry a request of up to 4 MiB; without them
+        // the virtio-nvgpu driver and backend both keep to 256 KiB.
+        DeviceType::Nvgpu => 1 << virtio_sys::virtio_ring::VIRTIO_RING_F_INDIRECT_DESC,
+        _ => 0,
+    }
+}
