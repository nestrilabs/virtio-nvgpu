@@ -0,0 +1,1957 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! What the main process lets a virtio-nvgpu device ask of it, and the UVM aperture.
+//!
+//! The device's vhost-user frontend may run in a process of its own. Its memory requests reach
+//! this process over the device's two `VmMemoryRequest` tubes, and nothing it says is taken on
+//! trust: each tube is held to what the device needs, against the BAR the PCI transport laid out
+//! here before the device process was made (`SharedMemoryBarLayout`).
+//!
+//! **The shared memory tube** may prepare region 1 (the window) and map descriptors into it, and
+//! unmap only what it mapped. Every mapping must lie inside the window, page-aligned, clear of the
+//! tube's other mappings, from a descriptor that is an NVIDIA device or a DRM node (the only files
+//! the backend places there), and writable only if that descriptor was opened for writing. It may
+//! also place UVM semaphore pools in region 2, the UVM aperture (below). Anything else --
+//! another allocation, a guest physical address, a source that is not a descriptor, ballooning,
+//! ioevents -- is refused.
+//!
+//! **The ioevent tube** may register and unregister ioevents, nothing else.
+//!
+//! **The UVM aperture.** A CUDA context maps a UVM semaphore pool at a host address equal to its
+//! file offset (UVM takes it nowhere else, `uvm.c` `uvm_mmap`), and that address is the guest's
+//! choice. So the pool is mapped in this process at exactly that address and given a memory slot
+//! of its own at an offset in region 2. The address must lie in [4 GiB, 32 TiB), where a 64-bit
+//! process has nothing of its own (its executable and heap sit at two-thirds of the 47-bit space,
+//! its mappings grow down from below the stack, or, under a legacy layout, up from a third of
+//! it). With `reserve_uvm_band` that band is also reserved, `PROT_NONE`, before anything else can
+//! be placed there, so a pool can never land on this process's own memory nor fail because this
+//! process happened to have something at its address. A pool is then mapped over the reservation
+//! (`MAP_FIXED` over a range this module owns and tracks, never over anything else), and on
+//! withdrawal the reservation is put back in the same step. Without the reservation a pool is
+//! mapped with `MAP_FIXED_NOREPLACE`. UVM will not take a mapping moved into place with
+//! `mremap` (its offset must equal the address at mmap time, and a semaphore pool's `vm_open`
+//! disables a moved mapping), so the window's map-then-move placement cannot be used.
+//!
+//! A slot is added only once the pages are known to be present (UVM can accept a mapping and
+//! insert nothing when it cannot take its power-management lock) and is removed before the
+//! mapping goes. Pools are bounded per device: 64 at once, 256 MiB in all, 64 MiB each. When the
+//! device's tube goes away, every pool it placed is withdrawn here.
+
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::io;
+use std::os::unix::fs::MetadataExt;
+use std::sync::Mutex;
+
+use base::error;
+use base::info;
+use base::warn;
+use base::AsRawDescriptor;
+use base::MappedRegion;
+use base::Protection;
+use base::SafeDescriptor;
+use hypervisor::MemCacheType;
+use hypervisor::MemSlot;
+use hypervisor::Vm;
+use resources::Alloc;
+use resources::SystemAllocator;
+use serde::Deserialize;
+use serde::Serialize;
+use vm_memory::GuestAddress;
+
+use crate::SharedMemoryBarLayout;
+use crate::SharedMemoryLayoutReport;
+use crate::VmMemoryDestination;
+use crate::VmMemoryRegionId;
+use crate::VmMemoryRegionState;
+use crate::VmMemoryRequest;
+use crate::VmMemoryResponse;
+use crate::VmMemorySource;
+
+pub use crate::nvgpu::NVGPU_SHM_ID_UVM;
+pub use crate::nvgpu::NVGPU_SHM_ID_WINDOW;
+pub use crate::nvgpu::UVM_APERTURE_MAX;
+pub use crate::nvgpu::UVM_HVA_MAX;
+pub use crate::nvgpu::UVM_HVA_MIN;
+pub use crate::nvgpu::UVM_MAX_POOLS;
+pub use crate::nvgpu::UVM_MAX_POOL_BYTES;
+pub use crate::nvgpu::UVM_POOL_MAX_LEN;
+
+/// Live window mappings per device. Without a prepared window each costs a KVM memory slot, and
+/// with one a mapping of this process's; either way the device must not be able to use them all.
+pub const WINDOW_MAX_MAPPINGS: usize = 16384;
+
+/// `/dev/nvidia*`: every GPU, `nvidiactl` and `nvidia-modeset`.
+const NVIDIA_MAJOR: u32 = 195;
+/// DRM card and render nodes.
+const DRM_MAJOR: u32 = 226;
+
+/// How a virtio-nvgpu device's tube is held, as `run_control` receives it.
+pub enum VmMemoryTubeRestriction {
+    /// The tube its shared memory is mapped through, held to the BAR the PCI transport reports
+    /// into this cell.
+    NvgpuSharedMemory(SharedMemoryLayoutReport),
+    /// The tube its ioevents are registered through.
+    NvgpuIoEvents,
+}
+
+impl VmMemoryTubeRestriction {
+    /// The policy, once the BAR has been laid out. A shared memory tube whose BAR was never laid
+    /// out gets a policy that refuses everything.
+    pub fn resolve(&self) -> NvgpuTubePolicy {
+        match self {
+            Self::NvgpuSharedMemory(report) => NvgpuTubePolicy::SharedMemory(report.get().cloned()),
+            Self::NvgpuIoEvents => NvgpuTubePolicy::IoEvents,
+        }
+    }
+}
+
+/// What a restricted tube may ask for.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub enum NvgpuTubePolicy {
+    /// Region 1 and region 2 of this BAR, as described above; `None` for nothing at all.
+    SharedMemory(Option<SharedMemoryBarLayout>),
+    /// Ioevents only.
+    IoEvents,
+}
+
+/// The two regions, checked.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Regions {
+    alloc: Alloc,
+    /// BAR offset and length.
+    window: (u64, u64),
+    aperture: Option<(u64, u64)>,
+}
+
+impl Regions {
+    fn from_layout(layout: &SharedMemoryBarLayout) -> Option<Regions> {
+        let page = base::pagesize() as u64;
+        let fits = |(offset, len): (u64, u64)| {
+            offset % page == 0
+                && len > 0
+                && offset
+                    .checked_add(len)
+                    .is_some_and(|end| end <= layout.size)
+        };
+        let window = layout.region(NVGPU_SHM_ID_WINDOW).filter(|&w| fits(w))?;
+        // The window is prepared as one arena from the start of the BAR.
+        if window.0 != 0 {
+            return None;
+        }
+        let aperture = layout
+            .region(NVGPU_SHM_ID_UVM)
+            .map(|(offset, len)| (offset, len.min(UVM_APERTURE_MAX) & !(page - 1)))
+            .filter(|&a| fits(a) && (a.0 >= window.0 + window.1 || a.0 + a.1 <= window.0));
+        Some(Regions {
+            alloc: layout.alloc,
+            window,
+            aperture,
+        })
+    }
+}
+
+/// What a descriptor is, as far as the checks here care.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FdKind {
+    NvidiaDevice,
+    Drm,
+    Uvm,
+    Other,
+}
+
+fn dev_major(rdev: u64) -> u32 {
+    (((rdev >> 32) & 0xffff_f000) | ((rdev >> 8) & 0x0000_0fff)) as u32
+}
+
+fn dev_minor(rdev: u64) -> u32 {
+    (((rdev >> 12) & 0xffff_ff00) | (rdev & 0x0000_00ff)) as u32
+}
+
+fn classify(mode: u32, rdev: u64, uvm_major: Option<u32>) -> FdKind {
+    if mode & libc::S_IFMT != libc::S_IFCHR {
+        return FdKind::Other;
+    }
+    match dev_major(rdev) {
+        NVIDIA_MAJOR => FdKind::NvidiaDevice,
+        DRM_MAJOR => FdKind::Drm,
+        // nvidia-uvm is minor 0 of its major; minor 1 is nvidia-uvm-tools.
+        m if Some(m) == uvm_major && dev_minor(rdev) == 0 => FdKind::Uvm,
+        _ => FdKind::Other,
+    }
+}
+
+/// The major of `name` among the character devices in `/proc/devices`.
+fn parse_char_major(proc_devices: &str, name: &str) -> Option<u32> {
+    let mut in_char = false;
+    for line in proc_devices.lines() {
+        match line.trim() {
+            "Character devices:" => in_char = true,
+            "Block devices:" => in_char = false,
+            l if in_char => {
+                let mut it = l.split_whitespace();
+                if let (Some(major), Some(n), None) = (it.next(), it.next(), it.next()) {
+                    if n == name {
+                        return major.parse().ok();
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+static UVM_MAJOR: Mutex<Option<u32>> = Mutex::new(None);
+
+/// Find nvidia-uvm's major now, if its module is loaded. Called at startup; if it was not
+/// loaded then, the first pool looks again.
+pub fn probe_host() -> Option<u32> {
+    let major = std::fs::read_to_string("/proc/devices")
+        .ok()
+        .and_then(|s| parse_char_major(&s, "nvidia-uvm"));
+    if major.is_some() {
+        *UVM_MAJOR.lock().unwrap_or_else(|e| e.into_inner()) = major;
+    }
+    major
+}
+
+fn uvm_major() -> Option<u32> {
+    let cached = *UVM_MAJOR.lock().unwrap_or_else(|e| e.into_inner());
+    cached.or_else(probe_host)
+}
+
+/// The descriptor's kind and its access mode (`O_ACCMODE` of its flags).
+fn describe(fd: &SafeDescriptor) -> io::Result<(FdKind, i32)> {
+    let file = File::from(fd.try_clone().map_err(io::Error::from)?);
+    let meta = file.metadata()?;
+    // SAFETY: F_GETFL reads the flags of a descriptor this function holds; nothing is written.
+    let flags = unsafe { libc::fcntl(file.as_raw_descriptor(), libc::F_GETFL) };
+    if flags < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut kind = classify(meta.mode(), meta.rdev(), uvm_major());
+    if kind == FdKind::Other && meta.mode() & libc::S_IFMT == libc::S_IFCHR && uvm_major().is_none()
+    {
+        // No nvidia-uvm in /proc/devices (another mount namespace's procfs): its path, then.
+        let link = std::fs::read_link(format!("/proc/self/fd/{}", file.as_raw_descriptor()));
+        if link.is_ok_and(|p| p.as_os_str() == "/dev/nvidia-uvm") {
+            kind = FdKind::Uvm;
+        }
+    }
+    Ok((kind, flags & libc::O_ACCMODE))
+}
+
+/// Whether a descriptor of `kind`, opened with `accmode`, may be mapped `writable` into the
+/// window. The backend places only the NVIDIA devices and DRM nodes there.
+fn window_fd_allowed(kind: FdKind, accmode: i32, writable: bool) -> bool {
+    matches!(kind, FdKind::NvidiaDevice | FdKind::Drm)
+        && match accmode {
+            libc::O_RDWR => true,
+            libc::O_RDONLY => !writable,
+            _ => false,
+        }
+}
+
+/// Whether a descriptor of `kind`, opened with `accmode`, may be mapped as a pool: nvidia-uvm
+/// itself, read-write (UVM maps a pool shared and writable only).
+fn uvm_fd_allowed(kind: FdKind, accmode: i32) -> bool {
+    kind == FdKind::Uvm && accmode == libc::O_RDWR
+}
+
+fn check_window_fd(fd: &SafeDescriptor, writable: bool) -> Result<(), i32> {
+    match describe(fd) {
+        Ok((kind, accmode)) if window_fd_allowed(kind, accmode, writable) => Ok(()),
+        Ok(_) => Err(libc::EPERM),
+        Err(e) => Err(e.raw_os_error().unwrap_or(libc::EBADF)),
+    }
+}
+
+fn check_uvm_fd(fd: &SafeDescriptor) -> Result<(), i32> {
+    match describe(fd) {
+        Ok((kind, accmode)) if uvm_fd_allowed(kind, accmode) => Ok(()),
+        Ok(_) => Err(libc::EPERM),
+        Err(e) => Err(e.raw_os_error().unwrap_or(libc::EBADF)),
+    }
+}
+
+/// Whether every page of `[addr, addr + len)` has a page behind it.
+fn resident(addr: u64, len: u64) -> io::Result<bool> {
+    let page = base::pagesize() as u64;
+    let mut vec = vec![0u8; len.div_ceil(page) as usize];
+    // SAFETY: `vec` has one byte per page of the range, as mincore writes; the range is only
+    // looked at.
+    let rc = unsafe {
+        libc::mincore(
+            addr as *mut libc::c_void,
+            len as usize,
+            vec.as_mut_ptr() as *mut libc::c_uchar,
+        )
+    };
+    if rc != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(vec.iter().all(|b| b & 1 != 0))
+}
+
+/// Whether `[addr, addr + len)` is covered, without a gap, by anonymous `PROT_NONE` private
+/// mappings: what the band's reservation looks like in `/proc/self/maps`.
+fn is_reservation(addr: u64, len: u64) -> bool {
+    let Ok(maps) = std::fs::read_to_string("/proc/self/maps") else {
+        return false;
+    };
+    let end = addr + len;
+    let mut next = addr;
+    for line in maps.lines() {
+        let mut f = line.split_whitespace();
+        let (Some(range), Some(perms), Some(_off), Some(_dev), Some(inode)) =
+            (f.next(), f.next(), f.next(), f.next(), f.next())
+        else {
+            continue;
+        };
+        let Some((s, e)) = range.split_once('-') else {
+            continue;
+        };
+        let (Ok(s), Ok(e)) = (u64::from_str_radix(s, 16), u64::from_str_radix(e, 16)) else {
+            continue;
+        };
+        if e <= next || s >= end {
+            continue;
+        }
+        if s > next || perms != "---p" || inode != "0" || f.next().is_some() {
+            return false;
+        }
+        next = e;
+        if next >= end {
+            return true;
+        }
+    }
+    false
+}
+
+/// The host address band pools are placed in, and what is placed there.
+pub struct UvmBand {
+    min: u64,
+    max: u64,
+    /// Whether all of `[min, max)` was reserved at startup.
+    reserved: bool,
+    /// Host address to length, for every pool mapped now, by any device.
+    live: BTreeMap<u64, u64>,
+    /// Ranges a failed placement or withdrawal left in a state this module no longer knows, and
+    /// so never maps over again.
+    tainted: Vec<(u64, u64)>,
+}
+
+/// This process's band.
+pub static UVM_BAND: Mutex<UvmBand> = Mutex::new(UvmBand::new(UVM_HVA_MIN, UVM_HVA_MAX));
+
+const RESERVE_FLAGS: i32 = libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_NORESERVE;
+
+/// Reserve this process's band, `PROT_NONE`, before anything else is placed in it. Call once, in
+/// the main process, before any thread or device process is started. Without it pools are mapped
+/// with `MAP_FIXED_NOREPLACE` and can collide with whatever else this process has there.
+pub fn reserve_uvm_band() -> io::Result<()> {
+    UVM_BAND.lock().unwrap_or_else(|e| e.into_inner()).reserve()
+}
+
+impl UvmBand {
+    pub const fn new(min: u64, max: u64) -> UvmBand {
+        UvmBand {
+            min,
+            max,
+            reserved: false,
+            live: BTreeMap::new(),
+            tainted: Vec::new(),
+        }
+    }
+
+    /// Reserve `[min, max)`: `PROT_NONE`, not accounted, and only if nothing is there yet.
+    pub fn reserve(&mut self) -> io::Result<()> {
+        if self.reserved {
+            return Ok(());
+        }
+        let len = (self.max - self.min) as usize;
+        // SAFETY: MAP_FIXED_NOREPLACE never displaces an existing mapping; the kernel refuses
+        // with EEXIST instead. A PROT_NONE anonymous mapping gives access to nothing.
+        let p = unsafe {
+            libc::mmap(
+                self.min as *mut libc::c_void,
+                len,
+                libc::PROT_NONE,
+                RESERVE_FLAGS | libc::MAP_FIXED_NOREPLACE,
+                -1,
+                0,
+            )
+        };
+        if p == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error());
+        }
+        if p as u64 != self.min {
+            // A kernel before 4.17 takes the flag as a hint. Not ours to keep.
+            // SAFETY: the mapping just made, at the address the kernel gave.
+            unsafe { libc::munmap(p, len) };
+            return Err(io::Error::from_raw_os_error(libc::EEXIST));
+        }
+        self.reserved = true;
+        Ok(())
+    }
+
+    pub fn is_reserved(&self) -> bool {
+        self.reserved
+    }
+
+    fn overlaps(&self, addr: u64, len: u64) -> bool {
+        let hit = |s: u64, l: u64| s < addr + len && addr < s + l;
+        self.live
+            .range(..addr + len)
+            .next_back()
+            .is_some_and(|(&s, &l)| hit(s, l))
+            || self.tainted.iter().any(|&(s, l)| hit(s, l))
+    }
+
+    /// Map `len` bytes of `fd` at `addr`, which is also the file offset, and check its pages are
+    /// present. On any error nothing of it is left mapped.
+    fn place(
+        band: &'static Mutex<UvmBand>,
+        fd: &SafeDescriptor,
+        addr: u64,
+        len: u64,
+    ) -> io::Result<UvmPoolMapping> {
+        let mut b = band.lock().unwrap_or_else(|e| e.into_inner());
+        if addr < b.min || addr.checked_add(len).is_none_or(|end| end > b.max) {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        if b.overlaps(addr, len) {
+            return Err(io::Error::from_raw_os_error(libc::EEXIST));
+        }
+        let fixed = if b.reserved {
+            libc::MAP_FIXED
+        } else {
+            libc::MAP_FIXED_NOREPLACE
+        };
+        // SAFETY: with the band reserved, `[addr, addr + len)` lies in the reservation, holds no
+        // live pool and is not tainted (both checked above under the band's lock), so what
+        // MAP_FIXED replaces is only reservation this module owns, which nothing refers to.
+        // Without it, NOREPLACE never displaces anything.
+        let p = unsafe {
+            libc::mmap(
+                addr as *mut libc::c_void,
+                len as usize,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED | fixed,
+                fd.as_raw_descriptor(),
+                addr as libc::off_t,
+            )
+        };
+        if p == libc::MAP_FAILED {
+            let e = io::Error::last_os_error();
+            if b.reserved {
+                b.repair(addr, len);
+            }
+            return Err(e);
+        }
+        if p as u64 != addr {
+            // Only a pre-4.17 kernel, which reads NOREPLACE as a hint, gets here.
+            // SAFETY: the mapping just made, at the address the kernel gave.
+            unsafe { libc::munmap(p, len as usize) };
+            return Err(io::Error::from_raw_os_error(libc::EEXIST));
+        }
+        b.live.insert(addr, len);
+        // UVM can accept the mapping and insert nothing (when it cannot take its
+        // power-management lock it disables the vma and reports success). A slot over that would
+        // stop the VM the first time the guest touched it.
+        match resident(addr, len) {
+            Ok(true) => {}
+            Ok(false) => {
+                b.release(addr, len);
+                return Err(io::Error::from_raw_os_error(libc::EFAULT));
+            }
+            Err(e) => {
+                b.release(addr, len);
+                return Err(e);
+            }
+        }
+        Ok(UvmPoolMapping { band, addr, len })
+    }
+
+    /// After a failed `MAP_FIXED` over the reservation: the kernel either put the reservation
+    /// back or left the range unmapped. Fill a hole; if the range holds anything but the
+    /// reservation, never map over it again.
+    fn repair(&mut self, addr: u64, len: u64) {
+        // SAFETY: NOREPLACE never displaces an existing mapping.
+        let p = unsafe {
+            libc::mmap(
+                addr as *mut libc::c_void,
+                len as usize,
+                libc::PROT_NONE,
+                RESERVE_FLAGS | libc::MAP_FIXED_NOREPLACE,
+                -1,
+                0,
+            )
+        };
+        if p != libc::MAP_FAILED && p as u64 == addr {
+            return;
+        }
+        if p != libc::MAP_FAILED {
+            // SAFETY: the mapping just made, at the address the kernel gave.
+            unsafe { libc::munmap(p, len as usize) };
+        }
+        if !is_reservation(addr, len) {
+            error!(
+                "nvgpu uvm: {:#x}+{:#x} is no longer reserved after a failed placement; never \
+                 placing there again",
+                addr, len
+            );
+            self.tainted.push((addr, len));
+        }
+    }
+
+    /// Take a pool's mapping away, putting the reservation back in the same step.
+    fn release(&mut self, addr: u64, len: u64) {
+        self.live.remove(&addr);
+        if self.reserved {
+            // SAFETY: `[addr, addr + len)` is a pool this band placed; its slot is gone (or was
+            // never made), so nothing refers to it. An anonymous PROT_NONE mapping replaces it.
+            let p = unsafe {
+                libc::mmap(
+                    addr as *mut libc::c_void,
+                    len as usize,
+                    libc::PROT_NONE,
+                    RESERVE_FLAGS | libc::MAP_FIXED,
+                    -1,
+                    0,
+                )
+            };
+            if p != libc::MAP_FAILED && p as u64 == addr {
+                return;
+            }
+            error!(
+                "nvgpu uvm: could not put the reservation back over {:#x}+{:#x}: {}",
+                addr,
+                len,
+                io::Error::last_os_error()
+            );
+            self.tainted.push((addr, len));
+        }
+        // SAFETY: as above; the pool's mapping, which nothing refers to.
+        if unsafe { libc::munmap(addr as *mut libc::c_void, len as usize) } != 0 {
+            warn!(
+                "nvgpu uvm: munmap {:#x}+{:#x}: {}",
+                addr,
+                len,
+                io::Error::last_os_error()
+            );
+        }
+    }
+}
+
+/// A pool mapped at its own address. Dropping it takes the mapping away.
+pub struct UvmPoolMapping {
+    band: &'static Mutex<UvmBand>,
+    addr: u64,
+    len: u64,
+}
+
+// SAFETY: `addr..addr + len` is a mapping this object owns: `UvmBand::place` made it, the band
+// records it as live so nothing else is placed over it, and only `drop` takes it away.
+unsafe impl MappedRegion for UvmPoolMapping {
+    fn as_ptr(&self) -> *mut u8 {
+        self.addr as *mut u8
+    }
+
+    fn size(&self) -> usize {
+        self.len as usize
+    }
+}
+
+impl Drop for UvmPoolMapping {
+    fn drop(&mut self) {
+        self.band
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .release(self.addr, self.len);
+    }
+}
+
+/// What a pool needs from the VM: where its offset is in guest physical memory, and slots.
+pub trait PoolHost {
+    fn guest_address(&mut self, alloc: Alloc, offset: u64, size: u64) -> Option<u64>;
+    fn add_slot(&mut self, gpa: u64, region: Box<dyn MappedRegion>) -> base::Result<MemSlot>;
+    fn remove_slot(&mut self, slot: MemSlot) -> base::Result<Box<dyn MappedRegion>>;
+}
+
+/// The real VM.
+pub struct VmPoolHost<'a> {
+    pub vm: &'a dyn Vm,
+    pub allocator: &'a mut SystemAllocator,
+}
+
+impl PoolHost for VmPoolHost<'_> {
+    fn guest_address(&mut self, alloc: Alloc, offset: u64, size: u64) -> Option<u64> {
+        self.allocator
+            .mmio_allocator_any()
+            .address_from_pci_offset(alloc, offset, size)
+            .ok()
+    }
+
+    fn add_slot(&mut self, gpa: u64, region: Box<dyn MappedRegion>) -> base::Result<MemSlot> {
+        self.vm.add_memory_region(
+            GuestAddress(gpa),
+            region,
+            false,
+            false,
+            MemCacheType::CacheCoherent,
+        )
+    }
+
+    fn remove_slot(&mut self, slot: MemSlot) -> base::Result<Box<dyn MappedRegion>> {
+        self.vm.remove_memory_region(slot)
+    }
+}
+
+/// What to do with a request from a restricted tube.
+pub enum NvgpuVerdict {
+    /// Refused, or done here: send this.
+    Respond(VmMemoryResponse),
+    /// Allowed: execute it as any other, then hand the response to `NvgpuTubeState::note`.
+    Execute(VmMemoryRequest, Pending),
+}
+
+/// What an executed request changes in a tube's record.
+pub enum Pending {
+    Nothing,
+    Register { offset: u64, len: u64 },
+    Unregister(VmMemoryRegionId),
+}
+
+enum Admission {
+    Refuse(i32, String),
+    Execute(VmMemoryRequest, Pending),
+    Prepare(Regions, MemCacheType),
+    MapPool {
+        descriptor: SafeDescriptor,
+        host_address: u64,
+        size: u64,
+        offset: u64,
+    },
+    UnmapPool {
+        offset: u64,
+        size: u64,
+    },
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Pool {
+    host_address: u64,
+    len: u64,
+    slot: MemSlot,
+}
+
+enum Role {
+    SharedMemory(Option<Regions>),
+    IoEvents,
+}
+
+/// One restricted tube's record: what it has mapped, and how many refusals it has had.
+pub struct NvgpuTubeState {
+    role: Role,
+    /// Window mappings, BAR offset to length (in whole pages).
+    window: BTreeMap<u64, u64>,
+    /// The region id each window mapping was registered under, to its BAR offset.
+    window_ids: BTreeMap<VmMemoryRegionId, u64>,
+    /// Pools, by BAR offset.
+    pools: BTreeMap<u64, Pool>,
+    pool_bytes: u64,
+    refusals: u64,
+    band: &'static Mutex<UvmBand>,
+    window_fd_check: fn(&SafeDescriptor, bool) -> Result<(), i32>,
+    uvm_fd_check: fn(&SafeDescriptor) -> Result<(), i32>,
+}
+
+fn err_response(errno: i32) -> VmMemoryResponse {
+    VmMemoryResponse::Err(anyhow::Error::new(base::Error::new(errno)).into())
+}
+
+impl NvgpuTubeState {
+    pub fn new(policy: NvgpuTubePolicy) -> NvgpuTubeState {
+        let role = match policy {
+            NvgpuTubePolicy::SharedMemory(layout) => {
+                let regions = layout.as_ref().and_then(Regions::from_layout);
+                if regions.is_none() {
+                    error!(
+                        "nvgpu: no usable shared memory layout ({:?}); every request of this \
+                         device's shared memory tube will be refused",
+                        layout
+                    );
+                }
+                Role::SharedMemory(regions)
+            }
+            NvgpuTubePolicy::IoEvents => Role::IoEvents,
+        };
+        NvgpuTubeState {
+            role,
+            window: BTreeMap::new(),
+            window_ids: BTreeMap::new(),
+            pools: BTreeMap::new(),
+            pool_bytes: 0,
+            refusals: 0,
+            band: &UVM_BAND,
+            window_fd_check: check_window_fd,
+            uvm_fd_check: check_uvm_fd,
+        }
+    }
+
+    /// Serve one request from this tube.
+    pub fn handle(
+        &mut self,
+        request: VmMemoryRequest,
+        vm: &dyn Vm,
+        allocator: &mut SystemAllocator,
+        region_state: &mut VmMemoryRegionState,
+    ) -> NvgpuVerdict {
+        let mut host = VmPoolHost { vm, allocator };
+        match self.admit(request) {
+            Admission::Refuse(errno, why) => NvgpuVerdict::Respond(self.refuse(errno, why)),
+            Admission::Execute(request, pending) => NvgpuVerdict::Execute(request, pending),
+            Admission::Prepare(regions, cache) => {
+                NvgpuVerdict::Respond(Self::prepare(regions, cache, &mut host, region_state))
+            }
+            Admission::MapPool {
+                descriptor,
+                host_address,
+                size,
+                offset,
+            } => NvgpuVerdict::Respond(self.map_pool(
+                &descriptor,
+                host_address,
+                size,
+                offset,
+                &mut host,
+            )),
+            Admission::UnmapPool { offset, size } => {
+                NvgpuVerdict::Respond(self.unmap_pool(offset, size, &mut host))
+            }
+        }
+    }
+
+    /// Record what an executed request did.
+    pub fn note(&mut self, pending: Pending, response: &VmMemoryResponse) {
+        match pending {
+            Pending::Nothing => {}
+            Pending::Register { offset, len } => {
+                if let VmMemoryResponse::RegisterMemory { region_id, .. } = response {
+                    self.window.insert(offset, len);
+                    self.window_ids.insert(*region_id, offset);
+                }
+            }
+            // Whatever the answer, the main process's own record of it is gone.
+            Pending::Unregister(id) => {
+                if let Some(offset) = self.window_ids.remove(&id) {
+                    self.window.remove(&offset);
+                }
+            }
+        }
+    }
+
+    /// The tube has gone -- its device process ended -- so nothing will withdraw what it placed:
+    /// withdraw every pool (slot first) and every window mapping here.
+    pub fn teardown(
+        &mut self,
+        vm: &dyn Vm,
+        allocator: &mut SystemAllocator,
+        region_state: &mut VmMemoryRegionState,
+    ) {
+        self.teardown_pools(&mut VmPoolHost { vm, allocator });
+        for id in self.take_window_ids() {
+            let res = match region_state.registered_memory.remove(&id) {
+                Some(crate::RegisteredMemory::DynamicMapping { slot }) => {
+                    vm.remove_memory_region(slot).map(drop)
+                }
+                Some(crate::RegisteredMemory::FixedMapping { slot, offset, size }) => {
+                    vm.remove_mapping(slot, offset, size)
+                }
+                None => Ok(()),
+            };
+            if let Err(e) = res {
+                warn!("nvgpu: teardown: window mapping {:?}: {}", id, e);
+            }
+        }
+    }
+
+    fn teardown_pools(&mut self, host: &mut dyn PoolHost) {
+        let pools: Vec<(u64, Pool)> = self.pools.iter().map(|(&o, &p)| (o, p)).collect();
+        for (offset, pool) in pools {
+            if let VmMemoryResponse::Err(e) = self.unmap_pool(offset, pool.len, host) {
+                warn!("nvgpu uvm: teardown: pool at {:#x}: {}", offset, e);
+            }
+        }
+    }
+
+    fn take_window_ids(&mut self) -> Vec<VmMemoryRegionId> {
+        self.window.clear();
+        std::mem::take(&mut self.window_ids).into_keys().collect()
+    }
+
+    fn refuse(&mut self, errno: i32, why: String) -> VmMemoryResponse {
+        self.refusals += 1;
+        let n = self.refusals;
+        if n <= 8 || n % 1024 == 0 {
+            warn!(
+                "nvgpu: refused a memory request from the device ({}; {} refused so far)",
+                why, n
+            );
+        }
+        err_response(errno)
+    }
+
+    fn admit(&mut self, request: VmMemoryRequest) -> Admission {
+        let regions = match &self.role {
+            Role::IoEvents => {
+                return match request {
+                    VmMemoryRequest::IoEventRaw(_) => Admission::Execute(request, Pending::Nothing),
+                    _ => Admission::Refuse(
+                        libc::EPERM,
+                        "the ioevent tube asked for something other than an ioevent".into(),
+                    ),
+                };
+            }
+            Role::SharedMemory(None) => {
+                return Admission::Refuse(libc::ENODEV, "no shared memory layout".into())
+            }
+            Role::SharedMemory(Some(r)) => *r,
+        };
+        match request {
+            VmMemoryRequest::PrepareSharedMemoryRegion { alloc, cache } => {
+                if alloc != regions.alloc || cache != MemCacheType::CacheCoherent {
+                    return Admission::Refuse(
+                        libc::EPERM,
+                        format!("prepare of {:?} ({:?})", alloc, cache),
+                    );
+                }
+                Admission::Prepare(regions, cache)
+            }
+            VmMemoryRequest::RegisterMemory {
+                source,
+                dest,
+                prot,
+                cache,
+            } => match self.check_window_mapping(&regions, &source, &dest, prot, cache) {
+                Ok((offset, len)) => Admission::Execute(
+                    VmMemoryRequest::RegisterMemory {
+                        source,
+                        dest,
+                        prot,
+                        cache,
+                    },
+                    Pending::Register { offset, len },
+                ),
+                Err((errno, why)) => Admission::Refuse(errno, why),
+            },
+            VmMemoryRequest::UnregisterMemory(id) => {
+                if self.window_ids.contains_key(&id) {
+                    Admission::Execute(
+                        VmMemoryRequest::UnregisterMemory(id),
+                        Pending::Unregister(id),
+                    )
+                } else {
+                    Admission::Refuse(libc::ENOENT, format!("unregister of {:?}, not its own", id))
+                }
+            }
+            VmMemoryRequest::RegisterUvmPool {
+                descriptor,
+                host_address,
+                file_offset,
+                size,
+                alloc,
+                offset,
+            } => match self.check_pool(
+                &regions,
+                &descriptor,
+                host_address,
+                file_offset,
+                size,
+                alloc,
+                offset,
+            ) {
+                Ok(()) => Admission::MapPool {
+                    descriptor,
+                    host_address,
+                    size,
+                    offset,
+                },
+                Err((errno, why)) => Admission::Refuse(errno, why),
+            },
+            VmMemoryRequest::UnregisterUvmPool {
+                alloc,
+                offset,
+                size,
+            } => {
+                if alloc != regions.alloc || self.pools.get(&offset).is_none_or(|p| p.len != size) {
+                    return Admission::Refuse(
+                        libc::ENOENT,
+                        format!("pool unmap {:#x}+{:#x}: no such pool", offset, size),
+                    );
+                }
+                Admission::UnmapPool { offset, size }
+            }
+            _ => Admission::Refuse(
+                libc::EPERM,
+                "the shared memory tube asked for something it has no use for".into(),
+            ),
+        }
+    }
+
+    /// A window mapping is allowed: returns its BAR offset and length in whole pages.
+    fn check_window_mapping(
+        &self,
+        regions: &Regions,
+        source: &VmMemorySource,
+        dest: &VmMemoryDestination,
+        prot: Protection,
+        cache: MemCacheType,
+    ) -> Result<(u64, u64), (i32, String)> {
+        let page = base::pagesize() as u64;
+        let VmMemorySource::Descriptor {
+            descriptor,
+            offset: fd_offset,
+            size,
+        } = source
+        else {
+            return Err((libc::EPERM, format!("window mapping from {}", source)));
+        };
+        let VmMemoryDestination::ExistingAllocation { allocation, offset } = *dest else {
+            return Err((
+                libc::EPERM,
+                "window mapping at a guest physical address".into(),
+            ));
+        };
+        let writable = if prot == Protection::read_write() {
+            true
+        } else if prot == Protection::read() {
+            false
+        } else {
+            return Err((libc::EPERM, format!("window mapping with {:?}", prot)));
+        };
+        if allocation != regions.alloc || cache != MemCacheType::CacheCoherent {
+            return Err((
+                libc::EPERM,
+                format!("window mapping into {:?} ({:?})", allocation, cache),
+            ));
+        }
+        let (w_off, w_len) = regions.window;
+        let len = size.checked_next_multiple_of(page).unwrap_or(0);
+        if *size == 0
+            || len == 0
+            || offset % page != 0
+            || fd_offset % page != 0
+            || fd_offset.checked_add(len).is_none()
+            || offset < w_off
+            || offset
+                .checked_add(len)
+                .is_none_or(|end| end > w_off + w_len)
+        {
+            return Err((
+                libc::EINVAL,
+                format!(
+                    "window mapping {:#x}+{:#x} (file offset {:#x}) outside the {:#x}-byte window",
+                    offset, size, fd_offset, w_len
+                ),
+            ));
+        }
+        if let Some((&s, &l)) = self.window.range(..offset + len).next_back() {
+            if s + l > offset {
+                return Err((
+                    libc::EEXIST,
+                    format!(
+                        "window mapping {:#x}+{:#x} overlaps {:#x}+{:#x}",
+                        offset, len, s, l
+                    ),
+                ));
+            }
+        }
+        if self.window.len() >= WINDOW_MAX_MAPPINGS {
+            return Err((libc::ENOSPC, "too many window mappings".into()));
+        }
+        if let Err(errno) = (self.window_fd_check)(descriptor, writable) {
+            return Err((
+                errno,
+                format!(
+                    "window mapping of a descriptor that is not an NVIDIA device or DRM node \
+                     opened for {}",
+                    if writable { "writing" } else { "reading" }
+                ),
+            ));
+        }
+        Ok((offset, len))
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn check_pool(
+        &self,
+        regions: &Regions,
+        descriptor: &SafeDescriptor,
+        host_address: u64,
+        file_offset: u64,
+        size: u64,
+        alloc: Alloc,
+        offset: u64,
+    ) -> Result<(), (i32, String)> {
+        let page = base::pagesize() as u64;
+        let Some((a_off, a_len)) = regions.aperture else {
+            return Err((libc::ENODEV, "pool without a UVM aperture".into()));
+        };
+        let what = format!(
+            "pool {:#x}+{:#x} at aperture {:#x}",
+            host_address, size, offset
+        );
+        if alloc != regions.alloc {
+            return Err((libc::EPERM, format!("{} into {:?}", what, alloc)));
+        }
+        // UVM's own rule: the offset is the address.
+        if file_offset != host_address {
+            return Err((
+                libc::EINVAL,
+                format!(
+                    "{}: file offset {:#x} is not its address",
+                    what, file_offset
+                ),
+            ));
+        }
+        if size == 0
+            || size % page != 0
+            || size > UVM_POOL_MAX_LEN
+            || host_address % page != 0
+            || host_address < UVM_HVA_MIN
+            || host_address
+                .checked_add(size)
+                .is_none_or(|end| end > UVM_HVA_MAX)
+            || offset % page != 0
+            || offset < a_off
+            || offset
+                .checked_add(size)
+                .is_none_or(|end| end > a_off + a_len)
+        {
+            return Err((libc::EINVAL, format!("{}: out of bounds", what)));
+        }
+        let hit = |s: u64, l: u64, a: u64, b: u64| s < a + b && a < s + l;
+        if self.pools.iter().any(|(&o, p)| {
+            hit(o, p.len, offset, size) || hit(p.host_address, p.len, host_address, size)
+        }) {
+            return Err((libc::EEXIST, format!("{}: overlaps a live pool", what)));
+        }
+        if self.pools.len() >= UVM_MAX_POOLS || self.pool_bytes + size > UVM_MAX_POOL_BYTES {
+            return Err((libc::ENOSPC, format!("{}: pool limits reached", what)));
+        }
+        if let Err(errno) = (self.uvm_fd_check)(descriptor) {
+            return Err((
+                errno,
+                format!(
+                    "{}: the descriptor is not /dev/nvidia-uvm opened read-write",
+                    what
+                ),
+            ));
+        }
+        Ok(())
+    }
+
+    fn prepare(
+        regions: Regions,
+        cache: MemCacheType,
+        host: &mut VmPoolHost,
+        region_state: &mut VmMemoryRegionState,
+    ) -> VmMemoryResponse {
+        if !super::should_prepare_memory_region()
+            || region_state.mapped_regions.contains_key(&regions.alloc)
+        {
+            return VmMemoryResponse::Ok;
+        }
+        // The window alone: the aperture's slots are the pools'.
+        match super::prepare_shared_memory_region_len(
+            host.vm,
+            host.allocator,
+            regions.alloc,
+            cache,
+            Some(regions.window.1),
+        ) {
+            Ok(region) => {
+                region_state.mapped_regions.insert(regions.alloc, region);
+                VmMemoryResponse::Ok
+            }
+            Err(e) => VmMemoryResponse::Err(anyhow::Error::new(e).into()),
+        }
+    }
+
+    fn map_pool(
+        &mut self,
+        descriptor: &SafeDescriptor,
+        host_address: u64,
+        size: u64,
+        offset: u64,
+        host: &mut dyn PoolHost,
+    ) -> VmMemoryResponse {
+        let Role::SharedMemory(Some(regions)) = self.role else {
+            return err_response(libc::ENODEV);
+        };
+        let Some(gpa) = host.guest_address(regions.alloc, offset, size) else {
+            return self.refuse(
+                libc::EINVAL,
+                format!("pool at {:#x}: no guest address", offset),
+            );
+        };
+        let mapping = match UvmBand::place(self.band, descriptor, host_address, size) {
+            Ok(m) => m,
+            Err(e) => {
+                return self.refuse(
+                    e.raw_os_error().unwrap_or(libc::EIO),
+                    format!("pool {:#x}+{:#x} not mapped: {}", host_address, size, e),
+                )
+            }
+        };
+        // On failure the mapping is dropped, which puts the reservation back.
+        let slot = match host.add_slot(gpa, Box::new(mapping)) {
+            Ok(slot) => slot,
+            Err(e) => {
+                warn!(
+                    "nvgpu uvm: no memory slot for {:#x}+{:#x}: {}",
+                    host_address, size, e
+                );
+                return err_response(libc::EIO);
+            }
+        };
+        self.pools.insert(
+            offset,
+            Pool {
+                host_address,
+                len: size,
+                slot,
+            },
+        );
+        self.pool_bytes += size;
+        info!(
+            "nvgpu uvm: {:#x}+{:#x} at aperture offset {:#x} (guest {:#x})",
+            host_address, size, offset, gpa
+        );
+        VmMemoryResponse::Ok
+    }
+
+    /// Remove one pool's slot, then its mapping. If the slot cannot be removed the mapping stays:
+    /// a slot over nothing would stop the VM, a stale slot over live pages only wastes them.
+    fn unmap_pool(&mut self, offset: u64, size: u64, host: &mut dyn PoolHost) -> VmMemoryResponse {
+        let Some(pool) = self.pools.get(&offset).copied().filter(|p| p.len == size) else {
+            return err_response(libc::ENOENT);
+        };
+        match host.remove_slot(pool.slot) {
+            Ok(region) => {
+                // The slot is gone; now the mapping.
+                drop(region);
+                self.pools.remove(&offset);
+                self.pool_bytes -= pool.len;
+                info!(
+                    "nvgpu uvm: dropped {:#x}+{:#x} at aperture offset {:#x}",
+                    pool.host_address, pool.len, offset
+                );
+                VmMemoryResponse::Ok
+            }
+            Err(e) => {
+                warn!(
+                    "nvgpu uvm: slot for aperture offset {:#x} not removed, mapping kept: {}",
+                    offset, e
+                );
+                err_response(libc::EIO)
+            }
+        }
+    }
+}
