+    #[test]
+    fn window_descriptors_must_be_nvidia_or_drm_and_opened_to_match() {
+        // The real check: /dev/null is a character device of major 1.
+        let mut s = NvgpuTubeState::new(NvgpuTubePolicy::SharedMemory(Some(layout(true))));
+        assert_eq!(admit_ok(&mut s, register(0, 4096, 0)), Some(libc::EPERM));
+        // A memfd is not a device at all.
+        let r = VmMemoryRequest::RegisterMemory {
+            source: VmMemorySource::Descriptor {
+                descriptor: pool_file(0, 4096, true),
+                offset: 0,
+                size: 4096,
+            },
+            dest: VmMemoryDestination::ExistingAllocation {
+                allocation: ALLOC,
+                offset: 0,
+            },
+            prot: Protection::read(),
+            cache: MemCacheType::CacheCoherent,
+        };
+        assert_eq!(errno(&s.admit(r)), Some(libc::EPERM));
+
+        let chr = libc::S_IFCHR | 0o666;
+        let dev = |major: u64, minor: u64| (major << 8) | minor;
+        assert_eq!(classify(chr, dev(195, 0), Some(511)), FdKind::NvidiaDevice);
+        assert_eq!(
+            classify(chr, dev(195, 255), Some(511)),
+            FdKind::NvidiaDevice
+        );
+        assert_eq!(classify(chr, dev(226, 128), Some(511)), FdKind::Drm);
+        assert_eq!(classify(chr, dev(1, 3), Some(511)), FdKind::Other);
+        // A block device or regular file with the same numbers is not one.
+        assert_eq!(
+            classify(libc::S_IFBLK | 0o666, dev(195, 0), None),
+            FdKind::Other
+        );
+        assert_eq!(
+            classify(libc::S_IFREG | 0o666, dev(226, 0), None),
+            FdKind::Other
+        );
+        // Majors above 255 are split across rdev.
+        let big = ((511u64 & 0xfff) << 8) | ((511u64 & !0xfff) << 32);
+        assert_eq!(classify(chr, big, Some(511)), FdKind::Uvm);
+        assert_eq!(classify(chr, big | 1, Some(511)), FdKind::Other); // nvidia-uvm-tools
+        assert_eq!(classify(chr, big, None), FdKind::Other);
+
+        for kind in [FdKind::NvidiaDevice, FdKind::Drm] {
+            assert!(window_fd_allowed(kind, libc::O_RDWR, true));
+            assert!(window_fd_allowed(kind, libc::O_RDWR, false));
+            assert!(window_fd_allowed(kind, libc::O_RDONLY, false));
+            assert!(!window_fd_allowed(kind, libc::O_RDONLY, true));
+            assert!(!window_fd_allowed(kind, libc::O_WRONLY, false));
+        }
+        assert!(!window_fd_allowed(FdKind::Uvm, libc::O_RDWR, true));
+        assert!(!window_fd_allowed(FdKind::Other, libc::O_RDWR, true));
+        assert!(uvm_fd_allowed(FdKind::Uvm, libc::O_RDWR));
+        assert!(!uvm_fd_allowed(FdKind::Uvm, libc::O_RDONLY));
+        assert!(!uvm_fd_allowed(FdKind::NvidiaDevice, libc::O_RDWR));
+    }
