+    /// A test band of its own, 1 GiB, at an address no other test uses.
+    fn band() -> (&'static Mutex<UvmBand>, u64) {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        // 2 GiB apart, so two tests' reservations never touch.
+        let base = 0x100_0000_0000 + NEXT.fetch_add(1, Ordering::SeqCst) * (2 << 30);
+        let band: &'static Mutex<UvmBand> =
+            Box::leak(Box::new(Mutex::new(UvmBand::new(base, base + (1 << 30)))));
+        (band, base)
+    }
