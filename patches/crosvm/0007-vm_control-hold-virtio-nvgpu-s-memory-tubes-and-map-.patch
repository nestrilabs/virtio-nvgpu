+//! virtio-nvgpu's shared memory regions and the bounds on its UVM aperture, which the device's
+//! vhost-user frontend checks first and the main process checks again (`sys::linux::nvgpu`).
+
+/// virtio-nvgpu's window: where the backend places device memory.
+pub const NVGPU_SHM_ID_WINDOW: u8 = 1;
+/// virtio-nvgpu's UVM aperture: where UVM semaphore pools get a memory slot each.
+pub const NVGPU_SHM_ID_UVM: u8 = 2;
+
+/// The host address band a pool must lie in: [4 GiB, 32 TiB). The backend and the guest driver
+/// hold pools to the same band.
+pub const UVM_HVA_MIN: u64 = 1 << 32;
+pub const UVM_HVA_MAX: u64 = 1 << 45;
+/// The largest pool. A semaphore pool is a few megabytes.
+pub const UVM_POOL_MAX_LEN: u64 = 64 << 20;
+/// Pools placed at once per device. Each costs a KVM memory slot.
+pub const UVM_MAX_POOLS: usize = 64;
+/// Bytes of pool placed at once per device.
+pub const UVM_MAX_POOL_BYTES: u64 = 256 << 20;
+/// The most of the aperture pools are placed in.
+pub const UVM_APERTURE_MAX: u64 = 1 << 30;
+/// The boundary a pool's aperture offset is on (the backend's placement unit).
+pub const UVM_APERTURE_ALIGN: u64 = 2 << 20;
