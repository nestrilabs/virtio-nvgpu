+    /// A slot table that checks the pool is still mapped whenever its slot goes.
+    #[derive(Default, Clone)]
+    struct FakeHost {
+        log: Arc<Mutex<Vec<String>>>,
+        fail_add: bool,
+        fail_remove: bool,
+        next: Arc<AtomicU64>,
+        slots: Arc<Mutex<BTreeMap<MemSlot, Box<dyn MappedRegion>>>>,
+    }
+
+    impl PoolHost for FakeHost {
+        fn guest_address(&mut self, alloc: Alloc, offset: u64, size: u64) -> Option<u64> {
+            (alloc == ALLOC && offset + size <= 2 << 30).then_some(BAR_GPA + offset)
+        }
+        fn add_slot(&mut self, gpa: u64, region: Box<dyn MappedRegion>) -> base::Result<MemSlot> {
+            if self.fail_add {
+                return Err(base::Error::new(libc::ENOSPC));
+            }
+            let mut slots = self.slots.lock().unwrap();
+            let slot = self.next.fetch_add(1, Ordering::SeqCst) as MemSlot + 100;
+            self.log.lock().unwrap().push(format!(
+                "add {:#x} -> {:#x}+{:#x}",
+                gpa,
+                region.as_ptr() as u64,
+                region.size()
+            ));
+            slots.insert(slot, region);
+            Ok(slot)
+        }
+        fn remove_slot(&mut self, slot: MemSlot) -> base::Result<Box<dyn MappedRegion>> {
+            if self.fail_remove {
+                return Err(base::Error::new(libc::EBUSY));
+            }
+            let region = self.slots.lock().unwrap().remove(&slot).unwrap();
+            // The slot must go while the pages are still mapped.
+            assert!(resident(region.as_ptr() as u64, region.size() as u64).unwrap());
+            self.log.lock().unwrap().push(format!("remove {}", slot));
+            Ok(region)
+        }
+    }
+
+    fn pool_req(fd: SafeDescriptor, hva: u64, size: u64, offset: u64) -> VmMemoryRequest {
+        VmMemoryRequest::RegisterUvmPool {
+            descriptor: fd,
+            host_address: hva,
+            file_offset: hva,
+            size,
+            alloc: ALLOC,
+            offset,
+        }
+    }
+
+    /// Admit and run a pool request against `host`.
+    fn run(s: &mut NvgpuTubeState, r: VmMemoryRequest, host: &mut FakeHost) -> Option<i32> {
+        let resp = match s.admit(r) {
+            Admission::Refuse(e, _) => return Some(e),
+            Admission::MapPool {
+                descriptor,
+                host_address,
+                size,
+                offset,
+            } => s.map_pool(&descriptor, host_address, size, offset, host),
+            Admission::UnmapPool { offset, size } => s.unmap_pool(offset, size, host),
+            _ => panic!("not a pool request"),
+        };
+        match resp {
+            VmMemoryResponse::Ok => None,
+            VmMemoryResponse::Err(e) => Some(
+                e.0.downcast_ref::<base::Error>()
+                    .map(|e| e.errno())
+                    .unwrap_or(-1),
+            ),
+            _ => Some(-2),
+        }
+    }
+
+    fn mapped(addr: u64, len: u64) -> bool {
+        resident(addr, len).is_ok()
+    }
+
+    fn pool_bounds(reserved: bool) {
+        let (band, base) = band();
+        if reserved {
+            band.lock().unwrap().reserve().unwrap();
+        }
+        let mut s = state(true);
+        s.band = band;
+        let mut host = FakeHost::default();
+        let ap = 1u64 << 30;
+        let page = base::pagesize() as u64;
+        let hva = base + 16 * MIB;
+
+        // The accept case: mapped at its address, a slot at its offset.
+        let f = pool_file(hva, 2 * MIB, true);
+        assert_eq!(run(&mut s, pool_req(f, hva, 2 * MIB, ap), &mut host), None);
+        assert!(resident(hva, 2 * MIB).unwrap());
+        assert_eq!(
+            host.log.lock().unwrap().last().unwrap(),
+            &format!("add {:#x} -> {:#x}+{:#x}", BAR_GPA + ap, hva, 2 * MIB)
+        );
+
+        let f = || pool_file(hva, 2 * MIB, true);
+        // Its file offset must be its address.
+        let mut r = pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + 4 * MIB);
+        if let VmMemoryRequest::RegisterUvmPool { file_offset, .. } = &mut r {
+            *file_offset = hva;
+        }
+        assert_eq!(run(&mut s, r, &mut host), Some(libc::EINVAL));
+        // Outside the band, unaligned, empty, too long, outside the aperture, in the window.
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), UVM_HVA_MIN - 2 * MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), UVM_HVA_MAX - MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB + 1, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB + 1, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 0, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 128 * MIB, 128 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + ap - MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB, ap - 2 * MIB),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + page / 2),
+                &mut host
+            ),
+            Some(libc::EINVAL)
+        );
+        // Another allocation.
+        let mut r = pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + 4 * MIB);
+        if let VmMemoryRequest::RegisterUvmPool { alloc, .. } = &mut r {
+            *alloc = Alloc::PciBar {
+                bus: 0,
+                dev: 4,
+                func: 0,
+                bar: 2,
+            };
+        }
+        assert_eq!(run(&mut s, r, &mut host), Some(libc::EPERM));
+        // Over a live pool, by offset or by address.
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + MIB),
+                &mut host
+            ),
+            Some(libc::EEXIST)
+        );
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EEXIST)
+        );
+        // A descriptor that is not nvidia-uvm.
+        s.uvm_fd_check = check_uvm_fd;
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f(), hva + 4 * MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EPERM)
+        );
+        s.uvm_fd_check = |_| Ok(());
+        // Pages not present: nothing left behind.
+        let sparse = pool_file(hva + 4 * MIB, 2 * MIB, false);
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(sparse, hva + 4 * MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EFAULT)
+        );
+        assert_eq!(mapped(hva + 4 * MIB, 2 * MIB), reserved);
+        assert!(!resident(hva + 4 * MIB, 2 * MIB).unwrap_or(false));
+        // No slot: nothing left behind either.
+        host.fail_add = true;
+        let f2 = pool_file(hva + 4 * MIB, 2 * MIB, true);
+        assert_eq!(
+            run(
+                &mut s,
+                pool_req(f2, hva + 4 * MIB, 2 * MIB, ap + 4 * MIB),
+                &mut host
+            ),
+            Some(libc::EIO)
+        );
+        assert_eq!(mapped(hva + 4 * MIB, 2 * MIB), reserved);
+        host.fail_add = false;
+        // Only the first pool is placed.
+        assert_eq!(s.pools.len(), 1);
+        assert_eq!(band.lock().unwrap().live.len(), 1);
+
+        // Withdrawal must name it exactly.
+        let unmap = |offset, size| VmMemoryRequest::UnregisterUvmPool {
+            alloc: ALLOC,
+            offset,
+            size,
+        };
+        assert_eq!(run(&mut s, unmap(ap, MIB), &mut host), Some(libc::ENOENT));
+        assert_eq!(
+            run(&mut s, unmap(ap + MIB, 2 * MIB), &mut host),
+            Some(libc::ENOENT)
+        );
+        // A slot that will not go keeps its mapping.
+        host.fail_remove = true;
+        assert_eq!(run(&mut s, unmap(ap, 2 * MIB), &mut host), Some(libc::EIO));
+        assert!(resident(hva, 2 * MIB).unwrap());
+        host.fail_remove = false;
+        assert_eq!(run(&mut s, unmap(ap, 2 * MIB), &mut host), None);
+        assert_eq!(host.log.lock().unwrap().last().unwrap(), "remove 100");
+        // Slot first (FakeHost checked), then the mapping; with a band, the reservation is back.
+        assert_eq!(mapped(hva, 2 * MIB), reserved);
+        if reserved {
+            assert!(is_reservation(hva, 2 * MIB));
+        }
+        assert!(s.pools.is_empty() && s.pool_bytes == 0);
+        assert!(band.lock().unwrap().live.is_empty());
+        assert_eq!(
+            run(&mut s, unmap(ap, 2 * MIB), &mut host),
+            Some(libc::ENOENT)
+        );
+    }
+
+    #[test]
+    fn pools_without_a_band() {
+        pool_bounds(false);
+    }
+
+    #[test]
+    fn pools_in_a_reserved_band() {
+        pool_bounds(true);
+    }
+
+    #[test]
+    fn pool_limits_and_teardown() {
+        let (band, base) = band();
+        band.lock().unwrap().reserve().unwrap();
+        let mut s = state(true);
+        s.band = band;
+        let mut host = FakeHost::default();
+        let ap = 1u64 << 30;
+        // One file for all of them, populated where each pool goes.
+        let file_len = 512 * MIB;
+        let file = pool_file(base, file_len, true);
+        let req =
+            |at: u64, size: u64| pool_req(file.try_clone().unwrap(), base + at, size, ap + at);
+        // Bytes: 256 MiB in all, in 32 pools of 8 MiB.
+        let len = 8 * MIB;
+        for i in 0..UVM_MAX_POOL_BYTES / len {
+            assert_eq!(
+                run(&mut s, req(i * len, len), &mut host),
+                None,
+                "pool {}",
+                i
+            );
+        }
+        assert_eq!(s.pools.len(), 32);
+        assert_eq!(
+            run(&mut s, req(UVM_MAX_POOL_BYTES, len), &mut host),
+            Some(libc::ENOSPC)
+        );
+        // Teardown withdraws them all, slot by slot, and puts the reservation back.
+        s.teardown_pools(&mut host);
+        assert!(s.pools.is_empty() && s.pool_bytes == 0);
+        assert!(host.slots.lock().unwrap().is_empty());
+        assert!(is_reservation(base, 1 << 30));
+        assert!(band.lock().unwrap().live.is_empty());
+
+        // Count: 64 at once, however small.
+        let page = base::pagesize() as u64;
+        for i in 0..UVM_MAX_POOLS as u64 {
+            assert_eq!(
+                run(&mut s, req(i * MIB, page), &mut host),
+                None,
+                "pool {}",
+                i
+            );
+        }
+        assert_eq!(
+            run(&mut s, req(256 * MIB, page), &mut host),
+            Some(libc::ENOSPC)
+        );
+        s.teardown_pools(&mut host);
+        assert!(is_reservation(base, 1 << 30));
+    }
+
+    #[test]
+    fn a_placement_the_file_refuses_leaves_the_band_reserved() {
+        let (band, base) = band();
+        band.lock().unwrap().reserve().unwrap();
+        // A pipe cannot be mapped: MAP_FIXED over the reservation fails in the file's mmap.
+        let mut fds = [0; 2];
+        // SAFETY: a plain syscall writing two descriptors into `fds`.
+        assert_eq!(unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC) }, 0);
+        // SAFETY: just created and owned by nothing else.
+        let (r, _w) = unsafe {
+            (
+                SafeDescriptor::from_raw_descriptor(fds[0]),
+                SafeDescriptor::from_raw_descriptor(fds[1]),
+            )
+        };
+        let hva = base + 64 * MIB;
+        assert!(UvmBand::place(band, &r, hva, 2 * MIB).is_err());
+        assert!(is_reservation(base, 1 << 30));
+        assert!(band.lock().unwrap().tainted.is_empty());
+    }
+
+    #[test]
+    fn a_band_is_not_reserved_over_something() {
+        let (band, base) = band();
+        // Something of ours in the middle of it.
+        // SAFETY: an anonymous mapping at a free address of this test's band.
+        let p = unsafe {
+            libc::mmap(
+                (base + 256 * MIB) as *mut libc::c_void,
+                4096,
+                libc::PROT_READ,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED_NOREPLACE,
+                -1,
+                0,
+            )
+        };
+        assert_eq!(p as u64, base + 256 * MIB);
+        assert!(band.lock().unwrap().reserve().is_err());
+        assert!(!band.lock().unwrap().is_reserved());
+        // SAFETY: the mapping made above.
+        unsafe { libc::munmap(p, 4096) };
+    }
+
+    #[test]
+    fn maps_parsing_finds_a_reservation() {
+        let (band, base) = band();
+        assert!(!is_reservation(base, MIB));
+        band.lock().unwrap().reserve().unwrap();
+        assert!(is_reservation(base, MIB));
+        assert!(is_reservation(base, 1 << 30));
+        assert!(!is_reservation(base, (1 << 30) + 4096));
+    }
