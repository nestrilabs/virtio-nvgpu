+/// As `prepare_shared_memory_region`, for the first `len` bytes of the allocation only (all of it
+/// when `None`): a BAR that holds more than one shared memory region prepares the first, and the
+/// rest are mapped some other way.
+pub fn prepare_shared_memory_region_len(
+    vm: &dyn Vm,
+    allocator: &mut SystemAllocator,
+    alloc: Alloc,
+    cache: MemCacheType,
+    len: Option<u64>,
 ) -> Result<VmMappedMemoryRegion, SysError> {
     if !matches!(alloc, Alloc::PciBar { .. }) {
         return Err(SysError::new(EINVAL));
     }
     match allocator.mmio_allocator_any().get(&alloc) {
         Some((range, _)) => {
-            let size: usize = match range.len().and_then(|x| x.try_into().ok()) {
+            let full = range.len();
+            let size = match (full, len) {
+                (Some(full), Some(len)) if len <= full && len > 0 => Some(len),
+                (Some(_), Some(_)) => return Err(SysError::new(EINVAL)),
+                (full, None) => full,
+                (None, Some(_)) => None,
+            };
+            let size: usize = match size.and_then(|x| x.try_into().ok()) {
                 Some(v) => v,
                 None => return Err(SysError::new(ERANGE)),
             };
diff --git a/vm_control/src/sys/linux/nvgpu.rs b/vm_control/src/sys/linux/nvgpu.rs
