+    /// A memfd whose pages at `[at, at + len)` exist when `populate`, standing in for a UVM file
+    /// whose pool is populated. Sparse everywhere else.
+    fn pool_file(at: u64, len: u64, populate: bool) -> SafeDescriptor {
+        let name = std::ffi::CString::new("uvm-pool").unwrap();
+        // SAFETY: a plain syscall; the descriptor is owned below.
+        let fd = unsafe { libc::memfd_create(name.as_ptr(), libc::MFD_CLOEXEC) };
+        assert!(fd >= 0);
+        // SAFETY: just created, and owned by nothing else.
+        let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+        let file = File::from(fd);
+        file.set_len(at + len).unwrap();
+        if populate {
+            use std::os::unix::fs::FileExt;
+            file.write_all_at(&vec![0xa5u8; len as usize], at).unwrap();
+        }
+        SafeDescriptor::from(file)
+    }
+
+    fn devnull() -> SafeDescriptor {
+        SafeDescriptor::from(File::open("/dev/null").unwrap())
+    }
+
+    fn register(offset: u64, size: u64, fd_offset: u64) -> VmMemoryRequest {
+        VmMemoryRequest::RegisterMemory {
+            source: VmMemorySource::Descriptor {
+                descriptor: devnull(),
+                offset: fd_offset,
+                size,
+            },
+            dest: VmMemoryDestination::ExistingAllocation {
+                allocation: ALLOC,
+                offset,
+            },
+            prot: Protection::read_write(),
+            cache: MemCacheType::CacheCoherent,
+        }
+    }
+
+    fn errno(a: &Admission) -> Option<i32> {
+        match a {
+            Admission::Refuse(e, _) => Some(*e),
+            _ => None,
+        }
+    }
+
+    /// Admit `r` and, if it would be executed, record it as having succeeded.
+    fn admit_ok(s: &mut NvgpuTubeState, r: VmMemoryRequest) -> Option<i32> {
+        match s.admit(r) {
+            Admission::Execute(_, Pending::Register { offset, len }) => {
+                s.note(
+                    Pending::Register { offset, len },
+                    &VmMemoryResponse::RegisterMemory {
+                        region_id: VmMemoryRegionId(GuestAddress(BAR_GPA + offset)),
+                        slot: 1,
+                    },
+                );
+                None
+            }
+            a => errno(&a),
+        }
+    }
