+    fn layout(aperture: bool) -> SharedMemoryBarLayout {
+        let mut regions = vec![(NVGPU_SHM_ID_WINDOW, 0, 1 << 30)];
+        if aperture {
+            regions.push((NVGPU_SHM_ID_UVM, 1 << 30, 1 << 30));
+        }
