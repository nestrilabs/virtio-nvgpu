+/// Where a device's shared memory regions sit in the one BAR that holds them, as the PCI transport
+/// laid them out. The main process uses it to hold a device's memory requests to the regions it
+/// really has, whatever the device process says (see `sys::linux::nvgpu`).
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SharedMemoryBarLayout {
+    /// The BAR's allocation.
+    pub alloc: Alloc,
+    /// The BAR's size.
+    pub size: u64,
+    /// Each region: its shared memory id, its offset in the BAR and its length.
+    pub regions: Vec<(u8, u64, u64)>,
+}
+
+impl SharedMemoryBarLayout {
+    /// The offset and length of region `id`.
+    pub fn region(&self, id: u8) -> Option<(u64, u64)> {
+        self.regions
+            .iter()
+            .find(|(i, _, _)| *i == id)
+            .map(|&(_, offset, len)| (offset, len))
+    }
+}
+
+/// Filled in once, by the PCI transport in the main process when it lays out the device's BAR --
+/// before the device is moved into a process of its own -- and read by the main process
+/// afterwards. A device process's copy is its own and changes nothing here.
+pub type SharedMemoryLayoutReport = Arc<std::sync::OnceLock<SharedMemoryBarLayout>>;
