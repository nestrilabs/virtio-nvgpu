+    #[test]
+    fn window_mappings_are_held_to_the_window() {
+        let mut s = state(true);
+        let page = base::pagesize() as u64;
+        // Inside, and a length that is not whole pages.
+        assert_eq!(admit_ok(&mut s, register(0, 0xc50, 0)), None);
+        assert_eq!(admit_ok(&mut s, register((1 << 30) - MIB, MIB, 0)), None);
+        // Past the window (into the aperture), wrapping, unaligned, empty.
+        assert_eq!(
+            admit_ok(&mut s, register(1 << 30, page, 0)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register((1 << 30) - page, 2 * page, 0)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register(u64::MAX - page + 1, page, 0)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register(8 * MIB + 1, page, 0)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register(8 * MIB, page, 1)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register(8 * MIB, 0, 0)),
+            Some(libc::EINVAL)
+        );
+        assert_eq!(
+            admit_ok(&mut s, register(8 * MIB, page, u64::MAX - page + 1)),
+            Some(libc::EINVAL)
+        );
+        // Overlapping a live mapping (the 0xc50 bytes cover a whole page).
+        assert_eq!(admit_ok(&mut s, register(0, page, 0)), Some(libc::EEXIST));
+        assert_eq!(admit_ok(&mut s, register(page, page, 0)), None);
+    }
