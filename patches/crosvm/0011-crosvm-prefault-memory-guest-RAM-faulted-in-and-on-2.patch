+/// Whether `--prefault-memory` applies to this VM (`create_guest_memory` says why not once).
+fn prefaults_memory(cfg: &Config) -> bool {
+    cfg.prefault_memory && !cfg.protection_type.isolates_memory()
+}
+
+/// The huge page size `--prefault-memory` collapses guest RAM into.
+const PREFAULT_HUGE_PAGE: u64 = 2 << 20;
+
+/// `MADV_POPULATE_WRITE` (Linux 5.14) and `MADV_COLLAPSE` (Linux 6.1).
+const MADV_POPULATE_WRITE: libc::c_int = 23;
+const MADV_COLLAPSE: libc::c_int = 25;
+
+/// Whether `--prefault-memory` fills a region: guest RAM, not a file the operator mapped in.
+fn is_prefaulted_ram(options: &MemoryRegionOptions) -> bool {
+    options.purpose == vm_memory::MemoryRegionPurpose::GuestMemoryRegion
+        && options.file_backed.is_none()
+}
+
+/// `--prefault-memory`: fault in all of guest RAM on a thread of its own, then collapse it into
+/// 2 MiB pages. Started as the vCPUs are, after every device process has been forked.
+///
+/// Without it every page of guest RAM is allocated and zeroed on the guest's first touch of it,
+/// a second-level fault and a host page fault each, one 4 KiB page at a time -- for as long as
+/// the guest keeps reaching memory it has not used yet, which a guest running a game does in
+/// bursts long after boot (a frame of 20-40 ms at a time). And guest memory is a memfd, whose
+/// huge pages the host's shmem policy decides: upstream's default, `never`, gives it none, so
+/// every guest access walks 4 KiB second-level pages.
+///
+/// `MADV_POPULATE_WRITE` allocates each page as a write would, without writing, so racing the
+/// booting guest is safe: a page the guest reached first is left as it is. `MADV_COLLAPSE` then
+/// turns what is present into 2 MiB pages whatever `shmem_enabled` says (except `deny`), copying
+/// where it has to; the guest sees the same memory throughout, as it does when khugepaged makes
+/// its rounds. One block at a time: over a whole range the kernel gives up at the first block
+/// it cannot find a huge page for. The cost is the whole of guest RAM committed as the VM starts
+/// rather than as the guest first uses it.
+fn spawn_guest_memory_prefault(guest_mem: GuestMemory) {
+    let spawned = std::thread::Builder::new()
+        .name("prefault".into())
+        .spawn(move || {
+            let started = std::time::Instant::now();
+            let ranges: Vec<(usize, usize)> = guest_mem
+                .regions()
+                .filter(|r| is_prefaulted_ram(&r.options))
+                .map(|r| (r.host_addr, r.size))
+                .collect();
+            for &(addr, size) in &ranges {
+                // SAFETY: a range of a mapping `guest_mem` keeps alive for as long as this thread
+                // holds it. POPULATE_WRITE writes nothing.
+                let ret =
+                    unsafe { libc::madvise(addr as *mut libc::c_void, size, MADV_POPULATE_WRITE) };
+                if ret != 0 {
+                    warn!(
+                        "prefault: guest RAM left to fault on first touch: {}",
+                        std::io::Error::last_os_error()
+                    );
+                    return;
+                }
+            }
+            let populated = started.elapsed();
+            let huge = PREFAULT_HUGE_PAGE as usize;
+            let (mut collapsed, mut refused) = (0usize, 0usize);
+            'ranges: for &(addr, size) in &ranges {
+                let mut block = addr.next_multiple_of(huge);
+                while block + huge <= addr + size {
+                    // SAFETY: as above; a collapse moves the contents into new pages and the
+                    // guest sees the same memory throughout.
+                    let ret =
+                        unsafe { libc::madvise(block as *mut libc::c_void, huge, MADV_COLLAPSE) };
+                    if ret == 0 {
+                        collapsed += 1;
+                    } else {
+                        let err = std::io::Error::last_os_error();
+                        refused += 1;
+                        // EINVAL: a kernel before 6.1, or a range it will not collapse at all.
+                        if err.raw_os_error() == Some(libc::EINVAL) {
+                            info!("prefault: guest RAM at {addr:#x} stays on small pages: {err}");
+                            continue 'ranges;
+                        }
+                    }
+                    block += huge;
+                }
+            }
+            info!(
+                "prefault: guest RAM faulted in after {populated:?}, collapsed after {:?}: \
+                 {} MiB on 2 MiB pages, {refused} blocks left small",
+                started.elapsed(),
+                collapsed * 2
+            );
+        });
+    if let Err(e) = spawned {
+        warn!("prefault: no thread, so guest RAM faults in on first touch: {e}");
+    }
+}
+
