diff --git a/base/src/sys/linux/mmap.rs b/base/src/sys/linux/mmap.rs
index 836a0f6..e9349fe 100644
--- a/base/src/sys/linux/mmap.rs
+++ b/base/src/sys/linux/mmap.rs
@@ -299,13 +299,17 @@ impl MemoryMapping {
             align
         };
 
-        // Add an address if an alignment is requested.
+        // Add an address if an alignment is requested. A file mapping is aligned relative to its
+        // offset (`addr % align == offset % align`), so that a block of the file on an `align`
+        // boundary -- a huge page -- is one at the same boundary of the mapping; for an offset on
+        // the boundary that is plain alignment.
         let (addr, orig_addr, orig_size) = match align {
             None | Some(0) => (addr, None, None),
             Some(align) => {
                 if !addr.is_null() || !align.is_power_of_two() {
                     return Err(Error::InvalidAlignment);
                 }
+                let phase = fd.map_or(0, |(_, offset)| offset & (align - 1));
                 let orig_size = size + align as usize;
                 let orig_addr = libc::mmap64(
                     null_mut(),
@@ -322,8 +326,11 @@ impl MemoryMapping {
                 flags |= libc::MAP_FIXED;
 
                 let mask = align - 1;
+                // The first address at or past `orig_addr` that is `phase` past a boundary: at
+                // most `mask` bytes in, so the mapping still ends inside the reservation.
+                let skip = phase.wrapping_sub(orig_addr as u64) & mask;
                 (
-                    (orig_addr.wrapping_add(mask as usize) as u64 & !mask) as *mut libc::c_void,
+                    orig_addr.wrapping_add(skip as usize),
                     Some(orig_addr),
                     Some(orig_size),
                 )
@@ -1402,6 +1409,38 @@ mod tests {
         unsafe { libc::munmap(p, 4 * ps) };
     }
 
+    /// A file mapping asked for an alignment is placed as far past a boundary as its file offset
+    /// is -- plain alignment for an offset on a boundary, as before -- and maps the file's bytes
+    /// at that offset; an anonymous one is plainly aligned.
+    #[test]
+    fn an_aligned_file_mapping_keeps_its_offset_phase() {
+        use std::os::unix::fs::FileExt;
+        let ps = pagesize() as u64;
+        let align = 2u64 << 20;
+        let f = tempfile().unwrap();
+        f.set_len(4 * align).unwrap();
+        for offset in [0, ps, align / 2, align, align + 3 * ps] {
+            f.write_all_at(&offset.to_le_bytes(), offset).unwrap();
+            let m = MemoryMappingBuilder::new(align as usize)
+                .from_file(&f)
+                .offset(offset)
+                .align(align)
+                .build()
+                .unwrap();
+            assert_eq!(
+                m.as_ptr() as u64 % align,
+                offset % align,
+                "offset {offset:#x}"
+            );
+            assert_eq!(m.read_obj::<u64>(0).unwrap(), offset);
+        }
+        let anon = MemoryMappingBuilder::new(align as usize)
+            .align(align)
+            .build()
+            .unwrap();
+        assert_eq!(anon.as_ptr() as u64 % align, 0);
+    }
+
     /// A hugetlbfs file never goes into an arena: its mapping would be a huge page long.
     #[test]
     fn arena_refuses_a_hugetlbfs_file() {
