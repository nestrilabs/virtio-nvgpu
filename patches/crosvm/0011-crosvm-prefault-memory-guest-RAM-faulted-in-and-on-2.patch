     use devices::GeniezoneKernelIrqChip;
@@ -4297,6 +4407,12 @@ fn run_control(
     #[cfg(not(target_arch = "x86_64"))]
     let nvgpu_prefault = None;
 
+    // Here, with every device process forked: a process with a thread of its own cannot fork a
+    // jail (minijail refuses), and guest RAM is only reached once the vCPUs run.
+    if prefaults_memory(&cfg) {
+        spawn_guest_memory_prefault(linux.vm.get_memory().clone());
+    }
+
     let (vcpu_pid_tid_sender, vcpu_pid_tid_receiver) = mpsc::channel();
     for ((cpu_id, vcpu), vcpu_init) in vcpus.into_iter().enumerate().zip(linux.vcpu_init.drain(..))
     {
