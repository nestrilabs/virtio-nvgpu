 base/src/sys/linux/mmap.rs | 268 ++++++++++++++++++++++++++++++++++---
 1 file changed, 252 insertions(+), 16 deletions(-)

diff --git a/base/src/sys/linux/mmap.rs b/base/src/sys/linux/mmap.rs
index 371cfea..836a0f6 100644
--- a/base/src/sys/linux/mmap.rs
+++ b/base/src/sys/linux/mmap.rs
@@ -636,6 +636,55 @@ impl Drop for MemoryMapping {
     }
 }
 
+/// Whether `fd` is a file of hugetlbfs.
+fn on_hugetlbfs(fd: RawDescriptor) -> Result<bool> {
+    // SAFETY: fstatfs writes one statfs into the zeroed struct.
+    let mut sfs: libc::statfs = unsafe { std::mem::zeroed() };
+    // SAFETY: as above.
+    if unsafe { libc::fstatfs(fd, &mut sfs) } != 0 {
+        return Err(Error::SystemCallFailed(ErrnoError::last()));
+    }
+    Ok(sfs.f_type as i64 == libc::HUGETLBFS_MAGIC as i64)
+}
+
+/// Put an arena's reservation back over `[target, target + size)`, which a failed
+/// `mremap(MREMAP_FIXED)` may have left unmapped.
+///
+/// With `MAP_FIXED_NOREPLACE`, never `MAP_FIXED`: another thread's mmap may have
+/// landed in the hole since, and replacing it would pull memory out from under that
+/// thread. An error means the range could not be refilled -- it is no longer only a
+/// hole, whatever is in it is not the arena's, and the caller must not carry on as if
+/// it were. (A move the kernel refused before it unmapped anything -- the process at
+/// its mapping limit, say -- also lands here, the reservation whole; the two cannot be
+/// told apart without trusting what /proc/self/maps says of a range another thread may
+/// be mapping into.)
+fn refill_hole(target: *mut u8, size: usize) -> std::result::Result<(), ErrnoError> {
+    // SAFETY: NOREPLACE never displaces an existing mapping.
+    let p = unsafe {
+        libc::mmap64(
+            target as *mut libc::c_void,
+            size,
+            libc::PROT_NONE,
+            libc::MAP_PRIVATE
+                | libc::MAP_ANONYMOUS
+                | libc::MAP_FIXED_NOREPLACE
+                | libc::MAP_NORESERVE,
+            -1,
+            0,
+        )
+    };
+    if p == target as *mut libc::c_void {
+        return Ok(());
+    }
+    if p == libc::MAP_FAILED {
+        return Err(ErrnoError::last());
+    }
+    // A kernel before 4.17 takes NOREPLACE as a hint and maps elsewhere.
+    // SAFETY: the mapping just made, at the address the kernel chose.
+    unsafe { libc::munmap(p, size) };
+    Err(ErrnoError::new(libc::EEXIST))
+}
+
 /// Tracks Fixed Memory Maps within an anonymous memory-mapped fixed-sized arena
 /// in the current process.
 pub struct MemoryMappingArena {
@@ -745,6 +794,9 @@ impl MemoryMappingArena {
 
     /// Helper method that calls appropriate MemoryMapping constructor and adds
     /// the resulting map into the arena.
+    ///
+    /// A failed file mapping never leaves a hole in the arena: see
+    /// [`refill_hole`].
     fn try_add(
         &mut self,
         offset: usize,
@@ -758,23 +810,77 @@ impl MemoryMappingArena {
         }
         validate_includes_range(self.size(), offset, size)?;
 
-        // SAFETY:
-        // This is safe since the range has been validated.
-        let mmap = unsafe {
-            match fd {
-                Some((fd, fd_offset)) => MemoryMapping::from_descriptor_offset_protection_fixed(
-                    self.addr.add(offset),
-                    fd,
-                    size,
-                    fd_offset,
-                    prot,
-                )?,
-                None => MemoryMapping::new_protection_fixed(self.addr.add(offset), size, prot)?,
+        // SAFETY: the range has been validated to lie within this arena, which
+        // this struct owns.
+        let target = unsafe { self.addr.add(offset) };
+
+        match fd {
+            Some((fd, fd_offset)) => {
+                // A file mapping is placed in two steps, not with one MAP_FIXED
+                // over the arena. mmap(MAP_FIXED) unmaps the target range *before*
+                // it invokes the file's own mmap operation, so a descriptor whose
+                // file cannot be mapped (a pipe or a socket), a bad file offset, or
+                // a writable request on a read-only descriptor would fail after the
+                // arena's reservation there was already gone -- leaving a hole an
+                // unrelated mmap could later fill, memory a guest would then reach
+                // through a KVM slot laid over this arena. Instead map the fd at an
+                // address the kernel picks, where a failure leaves the arena
+                // untouched, then move it over the target atomically with mremap.
+                // Not a hugetlbfs file: its mapping is rounded up to the huge page, so the move
+                // below would replace arena -- and whatever follows the arena -- past `size`.
+                if on_hugetlbfs(fd.as_raw_descriptor())? {
+                    return Err(Error::SystemCallFailed(ErrnoError::new(libc::EINVAL)));
+                }
+                let tmp = MemoryMapping::from_fd_offset_protection(fd, size, fd_offset, prot)?;
+                // SAFETY: `tmp` owns a live mapping of `size` bytes, and
+                // `target..target+size` is inside this arena. On success the
+                // mapping moves to `target` and `tmp`'s address is left empty; on
+                // failure mremap leaves the source mapping intact.
+                let ret = unsafe {
+                    libc::mremap(
+                        tmp.as_ptr() as *mut libc::c_void,
+                        size,
+                        size,
+                        libc::MREMAP_MAYMOVE | libc::MREMAP_FIXED,
+                        target as *mut libc::c_void,
+                    )
+                };
+                if ret == libc::MAP_FAILED {
+                    let err = ErrnoError::last();
+                    // mremap(MREMAP_FIXED) unmaps the destination before it moves,
+                    // so a failed move can leave a hole there. Restore the arena's
+                    // reservation over it (PROT_NONE, so a stray access faults here
+                    // rather than reading whatever lands next) before returning, or
+                    // stop the process if that cannot be done. `tmp` is then
+                    // dropped, unmapping the untouched source.
+                    if let Err(e) = refill_hole(target, size) {
+                        log::error!(
+                            "arena: {:p}+{:#x} could not be re-reserved after a failed \
+                             placement ({}); stopping, as whatever is there is reachable \
+                             through the arena",
+                            target,
+                            size,
+                            e
+                        );
+                        std::process::abort();
+                    }
+                    return Err(Error::SystemCallFailed(err));
+                }
+                // The mapping now lives at `target`; `tmp`'s address is empty, so
+                // its Drop must not run -- it would unmap whatever now sits there.
+                std::mem::forget(tmp);
             }
-        };
-
-        // This mapping will get automatically removed when we drop the whole arena.
-        std::mem::forget(mmap);
+            None => {
+                // Anonymous fixed mappings have no file operation that can fail
+                // after the target is unmapped, so a MAP_FIXED here does not leave
+                // a hole. This is also the path `remove` uses to re-reserve.
+                // SAFETY: the range has been validated to lie within this arena.
+                let mmap = unsafe { MemoryMapping::new_protection_fixed(target, size, prot)? };
+                // This mapping will get automatically removed when we drop the
+                // whole arena.
+                std::mem::forget(mmap);
+            }
+        }
         Ok(())
     }
 
