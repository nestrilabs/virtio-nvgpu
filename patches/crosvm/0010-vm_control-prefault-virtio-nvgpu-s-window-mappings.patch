+    /// The prefault vCPU's id is past every guest vCPU's, whatever ids the guest's have.
+    #[test]
+    fn the_prefault_vcpu_id_is_past_every_guest_vcpus() {
+        // The default: ids 0..n-1.
+        assert_eq!(prefault_vcpu_id(&[0, 1, 2, 3], 4), 4);
+        // --host-cpu-topology with vCPUs pinned to host CPUs 4-7: APIC ids 4-7, and 4 is taken.
+        assert_eq!(prefault_vcpu_id(&[4, 5, 6, 7], 4), 8);
+        // SMT siblings' APIC ids, with gaps, in any order.
+        assert_eq!(prefault_vcpu_id(&[14, 8, 12, 10], 4), 15);
+        // No ids known: past the count.
+        assert_eq!(prefault_vcpu_id(&[], 2), 2);
+        for ids in [&[0usize, 1][..], &[4, 5, 6, 7], &[14, 8, 12, 10]] {
+            assert!(!ids.contains(&prefault_vcpu_id(ids, ids.len())));
+        }
+    }
+
+    /// No call, and no call for this VM, stop the thread; a refused range does not.
+    #[test]
+    fn only_a_missing_call_stops_the_prefault_thread() {
+        for e in [libc::ENOSYS, libc::ENOTTY, libc::EOPNOTSUPP] {
+            assert!(prefault_unavailable(e), "{e}");
+        }
+        for e in [libc::EFAULT, libc::ENOENT, libc::EINVAL, libc::EIO] {
+            assert!(!prefault_unavailable(e), "{e}");
+        }
+    }
+
+    /// A window mapping that was registered is handed to the prefault thread -- the guest
+    /// address it was given, the admitted length -- and one that failed or was refused is not.
+    #[test]
+    fn a_registered_window_mapping_and_only_that_is_prefaulted() {
+        let (tx, rx) = std::sync::mpsc::sync_channel(PREFAULT_QUEUE);
+        let mut s = state(true).with_prefault(Some(tx));
+        let page = base::pagesize() as u64;
+        assert_eq!(admit_ok(&mut s, register(4 * page, 0xc50, 0)), None);
+        // Failed on execution: nothing recorded, nothing prefaulted.
+        match s.admit(register(8 * page, page, 0)) {
+            Admission::Execute(_, pending) => s.note(pending, &err_response(libc::ENOMEM)),
+            _ => panic!("admitted"),
+        }
+        // Outside the window: refused before anything.
+        assert!(admit_ok(&mut s, register(1 << 40, page, 0)).is_some());
+        let sent: Vec<(u64, u64)> = rx.try_iter().collect();
+        let len = 0xc50u64.div_ceil(page) * page;
+        assert_eq!(sent, vec![(BAR_GPA + 4 * page, len)]);
+    }
+
