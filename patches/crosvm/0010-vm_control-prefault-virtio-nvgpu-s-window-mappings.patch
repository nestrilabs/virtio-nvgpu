diff --git a/vm_control/src/sys/linux/nvgpu.rs b/vm_control/src/sys/linux/nvgpu.rs
index 493392a..ab32722 100644
--- a/vm_control/src/sys/linux/nvgpu.rs
+++ b/vm_control/src/sys/linux/nvgpu.rs
@@ -715,6 +715,57 @@ pub struct NvgpuTubeState {
     band: &'static Mutex<UvmBand>,
     window_fd_check: fn(&SafeDescriptor, bool) -> Result<(), i32>,
     uvm_fd_check: fn(&SafeDescriptor) -> Result<(), i32>,
+    /// Where each window mapping is sent to be prefaulted, if anywhere ([`Prefaulter`]).
+    prefault: Option<std::sync::mpsc::SyncSender<(u64, u64)>>,
+}
+
+/// Ranges waiting for the prefault thread, at most; past that a range is not prefaulted.
+pub const PREFAULT_QUEUE: usize = 1024;
+
+/// Fills in the guest's second-level page tables for each window mapping, ahead of its first
+/// touch.
+///
+/// A window mapping is in this process's address space at once, but KVM learns of it one fault
+/// at a time: every 4 KiB page's first access leaves the guest, about 3.1 us a page for BAR1
+/// video memory (a PFNMAP) on a Zen 5 host with Linux 7.2, so a guest wrote a fresh 64 MiB
+/// mapping at 1.3 GB/s against the host's 11. KVM_PRE_FAULT_MEMORY maps the same pages from
+/// inside the kernel, about 0.13 us a page, as a read fault would: video memory comes out
+/// writable, and the driver's system memory read-only, so a guest's first write of that still
+/// faults, once a page (its reads do not). It is a vCPU's call, and a vCPU in KVM_RUN -- where
+/// the guest's always are -- holds its own lock throughout, so it is made on `vcpu`: one more,
+/// that never runs (its APIC id is past every one the ACPI tables list, so the guest never
+/// starts it), given the supported CPUID as the others are, so it shares their TDP root. What it
+/// maps is only what the memory slots already back -- what the guest's own first access would
+/// map. It runs on a thread of its own after the mapping has been answered, so a map costs the
+/// guest nothing more; a guest that touches the range first takes the faults it always did, and
+/// a range withdrawn before its turn is refused by KVM (EFAULT) and passed over.
+pub struct Prefaulter;
+
+impl Prefaulter {
+    /// Start the thread; send it `(guest address, length)` pairs.
+    pub fn start<V: hypervisor::Vcpu + ?Sized + 'static>(
+        vcpu: std::sync::Arc<V>,
+    ) -> io::Result<std::sync::mpsc::SyncSender<(u64, u64)>> {
+        let (tx, rx) = std::sync::mpsc::sync_channel::<(u64, u64)>(PREFAULT_QUEUE);
+        std::thread::Builder::new()
+            .name("nvgpu_prefault".into())
+            .spawn(move || {
+                let mut refused = 0u64;
+                while let Ok((gpa, size)) = rx.recv() {
+                    if let Err(e) = vcpu.pre_fault_memory(gpa, size) {
+                        if e.errno() == libc::ENOSYS || e.errno() == libc::ENOTTY {
+                            warn!("nvgpu: KVM_PRE_FAULT_MEMORY unavailable ({}); not prefaulting", e);
+                            return;
+                        }
+                        refused += 1;
+                        if refused.is_power_of_two() {
+                            info!("nvgpu: prefault of {:#x}+{:#x}: {} ({} so far)", gpa, size, e, refused);
+                        }
+                    }
+                }
+            })?;
+        Ok(tx)
+    }
 }
 
 fn err_response(errno: i32) -> VmMemoryResponse {
@@ -756,9 +807,16 @@ impl NvgpuTubeState {
             band: &UVM_BAND,
             window_fd_check: check_window_fd,
             uvm_fd_check: check_uvm_fd,
+            prefault: None,
         }
     }
 
+    /// Prefault each window mapping from here on, through `tx` ([`Prefaulter`]).
+    pub fn with_prefault(mut self, tx: Option<std::sync::mpsc::SyncSender<(u64, u64)>>) -> Self {
+        self.prefault = tx;
+        self
+    }
+
     /// Serve one request from this tube.
     pub fn handle(
         &mut self,
@@ -800,6 +858,11 @@ impl NvgpuTubeState {
                 if let VmMemoryResponse::RegisterMemory { region_id, .. } = response {
                     self.window.insert(offset, len);
                     self.window_ids.insert(*region_id, offset);
+                    // The guest address it was placed at, the length admitted: a hint, dropped
+                    // when the queue is full.
+                    if let Some(tx) = &self.prefault {
+                        let _ = tx.try_send((region_id.0 .0, len));
+                    }
                 }
             }
             // Whatever the answer, the main process's own record of it is gone.
@@ -1400,6 +1463,26 @@ mod tests {
         }
     }
 
+    /// A window mapping that was registered is handed to the prefault thread -- the guest
+    /// address it was given, the admitted length -- and one that failed or was refused is not.
+    #[test]
+    fn a_registered_window_mapping_and_only_that_is_prefaulted() {
+        let (tx, rx) = std::sync::mpsc::sync_channel(PREFAULT_QUEUE);
+        let mut s = state(true).with_prefault(Some(tx));
+        let page = base::pagesize() as u64;
+        assert_eq!(admit_ok(&mut s, register(4 * page, 0xc50, 0)), None);
+        // Failed on execution: nothing recorded, nothing prefaulted.
+        match s.admit(register(8 * page, page, 0)) {
+            Admission::Execute(_, pending) => s.note(pending, &err_response(libc::ENOMEM)),
+            _ => panic!("admitted"),
+        }
+        // Outside the window: refused before anything.
+        assert!(admit_ok(&mut s, register(1 << 40, page, 0)).is_some());
+        let sent: Vec<(u64, u64)> = rx.try_iter().collect();
+        let len = 0xc50u64.div_ceil(page) * page;
+        assert_eq!(sent, vec![(BAR_GPA + 4 * page, len)]);
+    }
+
     #[test]
     fn window_mappings_are_held_to_the_window() {
         let mut s = state(true);
