index ab4af51..237e0b1 100644
--- a/vm_control/src/sys/linux/nvgpu.rs
+++ b/vm_control/src/sys/linux/nvgpu.rs
@@ -50,6 +50,7 @@ use std::sync::Mutex;
 
 use base::debug;
 use base::error;
+use base::info;
 use base::warn;
 use base::AsRawDescriptor;
 use base::MappedRegion;
@@ -721,6 +722,81 @@ pub struct NvgpuTubeState {
     band: &'static Mutex<UvmBand>,
     window_fd_check: fn(&SafeDescriptor, bool) -> Result<(), i32>,
     uvm_fd_check: fn(&SafeDescriptor) -> Result<(), i32>,
+    /// Where each window mapping is sent to be prefaulted, if anywhere ([`Prefaulter`]).
+    prefault: Option<std::sync::mpsc::SyncSender<(u64, u64)>>,
