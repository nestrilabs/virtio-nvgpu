+
+/// Ranges waiting for the prefault thread, at most; past that a range is not prefaulted.
+pub const PREFAULT_QUEUE: usize = 1024;
+
+/// Fills in the guest's second-level page tables for each window mapping, ahead of its first
+/// touch.
+///
+/// A window mapping is in this process's address space at once, but KVM learns of it one fault
+/// at a time: every 4 KiB page's first access leaves the guest, about 3.1 us a page for BAR1
+/// video memory (a PFNMAP) on a Zen 5 host with Linux 7.2, so a guest wrote a fresh 64 MiB
+/// mapping at 1.3 GB/s against the host's 11. KVM_PRE_FAULT_MEMORY maps the same pages from
+/// inside the kernel, about 0.13 us a page, as a read fault would: video memory comes out
+/// writable, and the driver's system memory read-only, so a guest's first write of that still
+/// faults, once a page (its reads do not). It is a vCPU's call, and a vCPU in KVM_RUN -- where
+/// the guest's always are -- holds its own lock throughout, so it is made on `vcpu`: one more,
+/// that never runs, with the id [`prefault_vcpu_id`] gives it (past every guest vCPU's, which
+/// are the APIC ids the ACPI tables list, so the guest never starts it), given the supported
+/// CPUID as the others are, so it shares their TDP root. What it maps is only what the memory
+/// slots already back -- what the guest's own first access would map. It runs on a thread of
+/// its own after the mapping has been answered, so a map costs the guest nothing more; a guest
+/// that touches the range first takes the faults it always did, and a range withdrawn before its
+/// turn is refused by KVM (EFAULT) and passed over.
+///
+/// The rule, the same as nesbox's: the vCPU is made only for a VM with an nvgpu device, and only
+/// where the VM says it has the call (`Vm::has_pre_fault_memory`); the thread stops for good at
+/// the first ENOSYS, ENOTTY or EOPNOTSUPP (no such call, or none for this VM: shadow paging, a
+/// protected VM), said once at info; any other refusal passes that range over, at debug.
+pub struct Prefaulter;
+
+/// The KVM vCPU id of the prefault vCPU: one past the largest id a guest vCPU has, and never
+/// below `vcpu_count`. With `--host-cpu-topology` and per-vCPU affinity the guest's ids are its
+/// host CPUs' APIC ids, which need not be 0..n-1, so `vcpu_count` itself may be one of them.
+/// crosvm lists exactly these ids in the MADT, so the prefault vCPU is in no ACPI table.
+pub fn prefault_vcpu_id(vcpu_ids: &[usize], vcpu_count: usize) -> usize {
+    vcpu_ids
+        .iter()
+        .map(|&id| id + 1)
+        .max()
+        .unwrap_or(0)
+        .max(vcpu_count)
+}
+
+/// Whether a prefault error means the call is not there at all, for any range of this VM.
+fn prefault_unavailable(errno: i32) -> bool {
+    errno == libc::ENOSYS || errno == libc::ENOTTY || errno == libc::EOPNOTSUPP
+}
+
+impl Prefaulter {
+    /// Start the thread; send it `(guest address, length)` pairs.
+    pub fn start<V: hypervisor::Vcpu + ?Sized + 'static>(
+        vcpu: std::sync::Arc<V>,
+    ) -> io::Result<std::sync::mpsc::SyncSender<(u64, u64)>> {
+        let (tx, rx) = std::sync::mpsc::sync_channel::<(u64, u64)>(PREFAULT_QUEUE);
+        std::thread::Builder::new()
+            .name("nvgpu_prefault".into())
+            .spawn(move || {
+                let mut refused = 0u64;
+                while let Ok((gpa, size)) = rx.recv() {
+                    if let Err(e) = vcpu.pre_fault_memory(gpa, size) {
+                        if prefault_unavailable(e.errno()) {
+                            info!("nvgpu: KVM_PRE_FAULT_MEMORY unavailable ({}); not prefaulting", e);
+                            return;
+                        }
+                        refused += 1;
+                        if refused.is_power_of_two() {
+                            debug!("nvgpu: prefault of {:#x}+{:#x}: {} ({} so far)", gpa, size, e, refused);
+                        }
+                    }
+                }
+            })?;
+        Ok(tx)
+    }
 }
 
