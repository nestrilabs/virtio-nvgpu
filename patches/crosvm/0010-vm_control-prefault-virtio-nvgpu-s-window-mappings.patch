 hypervisor/src/lib.rs             |  8 +++
 kvm_sys/src/lib.rs                |  1 +
 src/crosvm/sys/linux.rs           | 39 ++++++++++++++-
 vm_control/src/sys/linux/nvgpu.rs | 83 +++++++++++++++++++++++++++++++
 5 files changed, 150 insertions(+), 2 deletions(-)

diff --git a/hypervisor/src/kvm/mod.rs b/hypervisor/src/kvm/mod.rs
index c165a28..3683eb4 100644
--- a/hypervisor/src/kvm/mod.rs
+++ b/hypervisor/src/kvm/mod.rs
@@ -1080,6 +1080,27 @@ impl Vcpu for KvmVcpu {
         Ok(())
     }
 
+    fn pre_fault_memory(&self, gpa: u64, size: u64) -> Result<()> {
+        let mut r = kvm_pre_fault_memory {
+            gpa,
+            size,
+            ..Default::default()
+        };
+        while r.size > 0 {
+            // SAFETY:
+            // KVM_PRE_FAULT_MEMORY reads and writes exactly this struct, which lives for the
+            // call; it moves `gpa` and `size` on by what it did before an interruption.
+            let ret = unsafe { ioctl_with_mut_ref(self, KVM_PRE_FAULT_MEMORY, &mut r) };
+            if ret < 0 {
+                let e = Error::last();
+                if e.errno() != libc::EINTR && e.errno() != libc::EAGAIN {
+                    return Err(e);
+                }
+            }
+        }
+        Ok(())
+    }
+
     unsafe fn enable_raw_capability(&self, cap: u32, args: &[u64; 4]) -> Result<()> {
         let kvm_cap = kvm_enable_cap {
             cap,
diff --git a/hypervisor/src/lib.rs b/hypervisor/src/lib.rs
index 9324647..344b7ae 100644
--- a/hypervisor/src/lib.rs
+++ b/hypervisor/src/lib.rs
@@ -443,6 +443,14 @@ pub trait Vcpu: std::any::Any + Send + Sync {
     /// Signals to the hypervisor that this Vcpu is being paused by userspace.
     fn on_suspend(&self) -> Result<()>;
 
+    /// Populates the VM's second-level page tables for `[gpa, gpa + size)` ahead of the guest's
+    /// first access (KVM_PRE_FAULT_MEMORY), as far as the memory slots back it. Only through a
+    /// vCPU that is not running: a running one holds its own lock. ENOSYS where the hypervisor
+    /// has no such call.
+    fn pre_fault_memory(&self, _gpa: u64, _size: u64) -> Result<()> {
+        Err(base::Error::new(libc::ENOSYS))
+    }
+
     /// Enables a hypervisor-specific extension on this Vcpu.  `cap` is a constant defined by the
     /// hypervisor API (e.g., kvm.h).  `args` are the arguments for enabling the feature, if any.
     ///
diff --git a/kvm_sys/src/lib.rs b/kvm_sys/src/lib.rs
index 65a359f..2cf7f6b 100644
--- a/kvm_sys/src/lib.rs
+++ b/kvm_sys/src/lib.rs
@@ -173,3 +173,4 @@ ioctl_iow_nr!(KVM_SET_ONE_REG, KVMIO, 0xac, kvm_one_reg);
 ioctl_io_nr!(KVM_KVMCLOCK_CTRL, KVMIO, 0xad);
 ioctl_iowr_nr!(KVM_GET_REG_LIST, KVMIO, 0xb0, kvm_reg_list);
 ioctl_io_nr!(KVM_SMI, KVMIO, 0xb7);
+ioctl_iowr_nr!(KVM_PRE_FAULT_MEMORY, KVMIO, 0xd5, kvm_pre_fault_memory);
diff --git a/src/crosvm/sys/linux.rs b/src/crosvm/sys/linux.rs
index 6514967..6f909fd 100644
--- a/src/crosvm/sys/linux.rs
+++ b/src/crosvm/sys/linux.rs
@@ -4405,6 +4405,32 @@ fn run_control(
     });
     let vm_memory_control_client = VmMemoryClient::new(vm_memory_control_tube_2);
     let (vm_memory_handler_control, vm_memory_handler_control_for_thread) = Tube::pair()?;
+    // virtio-nvgpu's window mappings are prefaulted through one more vCPU, which never runs
+    // (vm_control::sys::linux::nvgpu::Prefaulter).
+    #[cfg(target_arch = "x86_64")]
+    let nvgpu_prefault = if vm_memory_control_tubes.iter().any(|t| t.policy.is_some()) {
+        let made = linux.vm.create_vcpu(linux.vcpu_count).and_then(|v| {
+            let cpuid = linux.vm.get_hypervisor().get_supported_cpuid()?;
+            v.set_cpuid(&cpuid)?;
+            Ok(v)
+        });
+        match made.map_err(anyhow::Error::from).and_then(|v| {
+            vm_control::sys::linux::nvgpu::Prefaulter::start(v).map_err(anyhow::Error::from)
+        }) {
+            Ok(tx) => {
+                info!("nvgpu: window mappings are prefaulted (KVM_PRE_FAULT_MEMORY)");
+                Some(tx)
+            }
+            Err(e) => {
+                warn!("nvgpu: no prefault vCPU ({:#}); the window faults in page by page", e);
+                None
+            }
+        }
+    } else {
+        None
+    };
+    #[cfg(not(target_arch = "x86_64"))]
+    let nvgpu_prefault = None;
     let vm_memory_handler_thread = std::thread::Builder::new()
         .name("vm_memory_handler_thread".into())
         .spawn({
@@ -4422,6 +4448,7 @@ fn run_control(
                     gralloc,
                     iommu_client,
                     vm_memory_handler_control_for_thread,
+                    nvgpu_prefault,
                 )
             }
         })
@@ -5147,6 +5174,7 @@ fn vm_memory_handler_thread(
     #[cfg(feature = "gpu")] mut gralloc: RutabagaGralloc,
     mut iommu_client: Option<VmMemoryRequestIommuClient>,
     handler_control: Tube,
+    nvgpu_prefault: Option<std::sync::mpsc::SyncSender<(u64, u64)>>,
 ) -> anyhow::Result<()> {
     #[derive(EventToken)]
     enum Token {
@@ -5163,7 +5191,10 @@ fn vm_memory_handler_thread(
     let mut next_control_id = control_tubes.len();
     for (id, socket) in control_tubes.iter_mut() {
         if let Some(policy) = socket.policy.take() {
-            restricted.insert(*id, NvgpuTubeState::new(policy));
+            restricted.insert(
+                *id,
+                NvgpuTubeState::new(policy).with_prefault(nvgpu_prefault.clone()),
+            );
         }
         wait_ctx
             .add(socket.as_ref(), Token::VmControl { id: *id })
@@ -5194,7 +5225,11 @@ fn vm_memory_handler_thread(
                                 let id = next_control_id;
                                 next_control_id += 1;
                                 if let Some(policy) = socket.policy.take() {
-                                    restricted.insert(id, NvgpuTubeState::new(policy));
+                                    restricted.insert(
+                                        id,
+                                        NvgpuTubeState::new(policy)
