+        // the ioctl then fails with ENOTTY at its first call, which ends the caller's use of it.
+        self.check_raw_capability(KvmCap::MemNoncoherentDmaOrPreFaultMemory)
+    }
+
     fn check_capability(&self, c: VmCap) -> bool {
         if let Some(val) = self.check_capability_arch(c) {
             return val;
@@ -1080,6 +1086,27 @@ impl Vcpu for KvmVcpu {
         Ok(())
     }
 
+    fn pre_fault_memory(&self, gpa: u64, size: u64) -> Result<()> {
+        let mut r = kvm_pre_fault_memory {
+            gpa,
+            size,
+            ..Default::default()
+        };
+        while r.size > 0 {
+            // SAFETY:
+            // KVM_PRE_FAULT_MEMORY reads and writes exactly this struct, which lives for the
+            // call; it moves `gpa` and `size` on by what it did before an interruption.
+            let ret = unsafe { ioctl_with_mut_ref(self, KVM_PRE_FAULT_MEMORY, &mut r) };
+            if ret < 0 {
+                let e = Error::last();
+                if e.errno() != libc::EINTR && e.errno() != libc::EAGAIN {
+                    return Err(e);
+                }
+            }
+        }
+        Ok(())
+    }
