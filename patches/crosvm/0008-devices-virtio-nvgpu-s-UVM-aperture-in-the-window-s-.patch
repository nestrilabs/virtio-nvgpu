+    /// Whether a UVM pool may be placed: shared and writable (UVM maps a pool no other way), at a
+    /// host address -- its file offset -- in the band nothing else of the VMM's is in, a whole
+    /// number of pages no longer than a pool can be, at an aperture offset on the backend's
+    /// placement boundary, inside the aperture, clear of every live pool both in the aperture and
+    /// in host memory, and within the per-device limits. The process that owns the VM checks all
+    /// of it again against its own record, and the descriptor too.
+    fn check_new_pool(&self, req: &VhostUserMMap) -> HandlerResult<()> {
+        let page = base::pagesize() as u64;
+        // Copied out: the message is packed.
+        let (hva, offset, len, flags) = (req.fd_offset, req.shm_offset, req.len, req.flags);
+        if flags != VhostUserMMapFlags::MAP_RW
+            || len == 0
+            || len % page != 0
+            || len > nvgpu::UVM_POOL_MAX_LEN
+            || hva % page != 0
+            || hva < nvgpu::UVM_HVA_MIN
+            || hva
+                .checked_add(len)
+                .is_none_or(|end| end > nvgpu::UVM_HVA_MAX)
+            || offset % nvgpu::UVM_APERTURE_ALIGN != 0
+            || offset.checked_add(len).is_none_or(|end| end > self.length)
+        {
+            error!(
+                "refusing UVM pool {:#x}+{:#x} at aperture offset {:#x} (flags {:?}): out of bounds",
+                hva, len, offset, flags
+            );
+            return Err(errno(libc::EINVAL));
+        }
+        let hit = |s: u64, l: u64, a: u64| s < a + len && a < s + l;
+        if self
+            .mappings
+            .iter()
+            .any(|(&o, &(l, h))| hit(o, l, offset) || hit(h, l, hva))
+        {
+            error!(
+                "refusing UVM pool {:#x}+{:#x} at aperture offset {:#x}: overlaps a live pool",
+                hva, len, offset
+            );
+            return Err(errno(libc::EEXIST));
+        }
+        let bytes: u64 = self.mappings.values().map(|&(l, _)| l).sum();
+        if self.mappings.len() >= nvgpu::UVM_MAX_POOLS || bytes + len > nvgpu::UVM_MAX_POOL_BYTES {
+            error!(
+                "refusing UVM pool {:#x}+{:#x}: {} pools, {:#x} bytes already placed",
+                hva,
+                len,
+                self.mappings.len(),
+                bytes
+            );
+            return Err(errno(libc::ENOSPC));
+        }
+        Ok(())
+    }
+}
