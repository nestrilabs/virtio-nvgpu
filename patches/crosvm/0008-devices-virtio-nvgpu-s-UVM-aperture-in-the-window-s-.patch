+/// Where each of a device's shared memory regions goes in the one BAR that holds them all: the
+/// first at 0, each next one on a boundary of its own size (a power of two, at most 1 GiB, at least
+/// a page). Returns the offsets and the BAR's size, a power of two; `None` if they would not fit in
+/// `max_bar` bytes. One region is at 0 in a BAR of its length rounded up to a power of two, as it
+/// always was.
+pub fn shared_memory_bar_layout(
+    regions: &[SharedMemoryRegion],
+    max_bar: u64,
+) -> Option<(Vec<u64>, u64)> {
+    let page = base::pagesize() as u64;
+    let mut end = 0u64;
+    let mut offsets = Vec::with_capacity(regions.len());
+    for region in regions {
+        let align = region
+            .length
+            .checked_next_power_of_two()?
+            .clamp(page, 1 << 30);
+        let offset = end.checked_next_multiple_of(align)?;
+        offsets.push(offset);
+        end = offset.checked_add(region.length)?;
+    }
+    let size = end.checked_next_power_of_two()?;
+    (size <= max_bar).then_some((offsets, size))
