# SPDX-License-Identifier: Apache-2.0
#
# The host's CPU wake-up latency held at %i microseconds while a VM that
# wants it runs: a VMM unit's drop-in says
#   [Unit]
#   Wants=nvgpu-cpu-latency@50.service
#   After=nvgpu-cpu-latency@50.service
# and the instance stops once no running unit wants it. Several instances
# at once: the kernel takes the lowest. What it costs and gains is in
# DEPLOY.md, "Tuning": deeper C-states are what an idle host saves power
# with, and none is entered while this runs. Off unless a VM asks for it.

[Unit]
Description=Host CPU wake-up latency held at %i us for the VMs that want it
StopWhenUnneeded=yes

[Service]
Type=exec
# Root's: /dev/cpu_dma_latency is 0600 root. It needs no capability (it
# owns the node) and nothing else.
ExecStart=/usr/libexec/virtio-nvgpu/nvgpu-cpu-latency %i
Restart=no
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/cpu_dma_latency w
PrivateNetwork=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
