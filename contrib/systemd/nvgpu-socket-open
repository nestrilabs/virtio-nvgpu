#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# nvgpu-socket-open DIR GROUP [INJECT_GROUP]
#
# Run as root (ExecStartPost=+ in vhost-user-nvgpu@.service) once the backend
# has started: wait for its socket DIR/nvgpu.sock, make DIR root's (0711) so
# the backend's user can no longer rename, replace or link anything in it,
# then check the socket is a socket, not a link, and the backend's, and open
# it to GROUP (0660), the group the VM's VMM user is in. The backend creates
# it 0600 (umask 077), so without this only the backend's own uid could
# connect. The same steps, in the same order, as the rig launcher's root mode.
#
# With INJECT_GROUP, the capture helper's socket DIR/inject.sock
# (--inject-socket) gets the same checks and is opened to INJECT_GROUP, the
# VM's capture helper's own group (SECURITY.md §18). The backend still serves
# only its --inject-uid there.
set -eu

usage="usage: nvgpu-socket-open DIR GROUP [INJECT_GROUP]"
dir=${1:?$usage}
group=${2:?$usage}
inject_group=${3:-}
sock=$dir/nvgpu.sock

[ -d "$dir" ] && [ ! -L "$dir" ] || { echo "nvgpu-socket-open: $dir is not a directory" >&2; exit 1; }
owner=$(stat -c %u -- "$dir")

# The backend binds its socket before its sandbox, within a second or two
# of starting; it refuses to start at all on a host it cannot serve.
wait_for() {
    i=0
    while [ ! -S "$1" ]; do
        i=$((i + 1))
        [ "$i" -le 100 ] || { echo "nvgpu-socket-open: no socket at $1 after 10 s" >&2; exit 1; }
        sleep 0.1
    done
}
wait_for "$sock"
# Bound before the sandbox, as the vhost-user socket is (device/src/inject.rs).
[ -z "$inject_group" ] || wait_for "$dir/inject.sock"

chown root:root -- "$dir"
chmod 0711 -- "$dir"

open_to() { # SOCKET GROUP
    [ ! -L "$1" ] || { echo "nvgpu-socket-open: $1 is a symbolic link; refusing it" >&2; exit 1; }
    [ -S "$1" ] || { echo "nvgpu-socket-open: $1 is not a socket" >&2; exit 1; }
    [ "$(stat -c %u -- "$1")" = "$owner" ] || {
        echo "nvgpu-socket-open: $1 is not owned by the backend's user (uid $owner)" >&2
        exit 1
    }
    chgrp -h -- "$2" "$1"
    chmod 0660 -- "$1"
}
open_to "$sock" "$group"
[ -z "$inject_group" ] || open_to "$dir/inject.sock" "$inject_group"
